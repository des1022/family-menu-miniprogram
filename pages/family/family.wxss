.hd { padding: 24rpx 4rpx 20rpx; }

/* ---------- 成员 ---------- */
.mem {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 26rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--sh);
}
.mem-av {
  width: 80rpx; height: 80rpx; flex: 0 0 auto;
  border-radius: 50%;
  color: #fff; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  /* 同色淡影在 wxml 里内联（颜色来自 item.color），这里只兜底一个极淡的 */
  box-shadow: 0 6rpx 18rpx rgba(170, 130, 100, 0.18);
}
.mem-av-img { width: 100%; height: 100%; }
.mem-main { flex: 1; min-width: 0; }
.mem-nm { display: flex; align-items: center; gap: 12rpx; font-size: 30rpx; font-weight: 700; }
.mem-me {
  font-size: 19rpx; font-weight: 700;
  background: var(--pri-l); color: var(--pri-ink);
  border-radius: 6rpx; padding: 2rpx 10rpx;
}
.mem-tg { font-size: 23rpx; color: var(--ink2); margin-top: 6rpx; }
.mem-tip { font-size: 22rpx; color: var(--ink3); padding: 6rpx 8rpx 0; line-height: 1.6; }

/* ---------- 开关 ---------- */
.sw {
  width: 84rpx; height: 48rpx; flex: 0 0 auto;
  border-radius: 999rpx;
  background: var(--pri);
  position: relative;
  transition: background 0.18s;
}
.theme-dark .sw { background: #FFFFFF; }
.sw--off { background: var(--line); }
.theme-dark .sw--off { background: rgba(255, 255, 255, 0.26); }
.sw-knob {
  position: absolute;
  width: 38rpx; height: 38rpx;
  border-radius: 50%;
  background: #fff;
  top: 5rpx; right: 5rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
  transition: right 0.18s, left 0.18s;
}
.theme-dark .sw-knob { background: #2A5F54; }
.sw--off .sw-knob { right: auto; left: 5rpx; background: #fff; }
.theme-dark .sw--off .sw-knob { background: #A0C3B9; }

/* @media 跟随系统时的深色适配 */
@media (prefers-color-scheme: dark) {
  .sw { background: #FFFFFF; }
  .sw-knob { background: #2A5F54; }
  .sw--off { background: rgba(255, 255, 255, 0.26); }
  .sw--off .sw-knob { background: #A0C3B9; }
}

/* ---------- 行内图标 ---------- */
.row-img { width: 38rpx; height: 38rpx; }

/* ---------- 外观 ---------- */
/* 三选一做成「色块预览卡」：浅色 / 深色 / 跟随系统，选哪个一眼就懂，
   不用先读文字再猜（2026-10-12）。预览色是固定的（它就是「长什么样」），不跟当前主题变。 */
.tpick { display: flex; gap: 18rpx; }
.tp {
  flex: 1;
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx 12rpx 14rpx;
  background: var(--surf);
  text-align: center;
}
.tp--on { border-color: var(--pri); background: var(--pri-l); }
.tp-sw {
  height: 68rpx;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
}
.tp-dot { width: 24rpx; height: 24rpx; border-radius: 50%; }
.tp-sw--0 { background: linear-gradient(90deg, #FAF7F3 0 50%, #37776A 50% 100%); }
.tp-sw--0 .tp-dot { background: #D9714E; }
.tp-sw--1 { background: #FAF7F3; }
.tp-sw--1 .tp-dot { background: #D9714E; }
.tp-sw--2 { background: #37776A; }
.tp-sw--2 .tp-dot { background: #FFFFFF; }
.tp-lb { font-size: 23rpx; font-weight: 600; color: var(--ink2); }
.tp--on .tp-lb { color: var(--pri-ink); }
.theme-tip { font-size: 23rpx; color: var(--ink2); margin-top: 18rpx; }

/* ---------- 关于 ---------- */
/* 小程序头像（圆形 布布 图），自带底色，所以行图标那枚浅底方块去掉 */
.row .row-ic--logo { background: transparent; }
.row-logo { width: 62rpx; height: 62rpx; border-radius: 50%; }

.about-tx { font-size: 23rpx; color: var(--ink3); line-height: 1.7; padding: 16rpx 8rpx 0; }

/* ---------- 成员编辑表单 ---------- */
.fm { margin-bottom: 28rpx; }
.fm-l { font-size: 24rpx; font-weight: 700; color: var(--ink2); margin-bottom: 14rpx; }
.fm-input {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  /* 必须给明确高度：原生 input 没有高度、又带上下 padding 时，
     输入区会被压扁，占位文字上下被切（2026-10-09 真机反馈）。
     写法对齐 pages/category 的 .add-input。 */
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--ink);
}
.fm-ph { color: var(--ink3); }
.fm-taste { display: flex; flex-wrap: wrap; gap: 12rpx; }

/* ---------------- 换头像 ---------------- */
.av-edit { display: flex; align-items: center; gap: 24rpx; }
/* 这是个 button（open-type="chooseAvatar" 必须用 button 才拿得到微信头像），
   所以要把它自己那套默认样式（灰底、圆角、::after 细边框）全部清掉。
   注意 overflow:hidden 会把里面的「换」角标裁掉，所以角标要留在圆圈里面一点。 */
.av-btn {
  position: relative;
  width: 132rpx; height: 132rpx;
  flex: 0 0 auto;
  margin: 0; padding: 0; line-height: 1;
  border: none; border-radius: 50%;
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 46rpx; font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(170, 130, 100, 0.22);
}
.av-btn::after { border: none; }
.av-img { width: 100%; height: 100%; }
.av-tx { color: #fff; }
.av-cam {
  position: absolute; right: 6rpx; bottom: 6rpx;
  width: 42rpx; height: 42rpx; border-radius: 50%;
  background: var(--surf); color: var(--pri-ink);
  border: 2rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700;
}
.av-side { flex: 1; min-width: 0; }
.av-lnk { font-size: 24rpx; font-weight: 600; color: var(--ink2); }
.av-lnk--pri { color: var(--pri-ink); }
.av-lnks { display: flex; gap: 24rpx; margin-top: 10rpx; }

/* 「我」是谁 */
.fm-me {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--surf2);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink2);
}
.fm-me-ok { color: var(--pri-ink); font-weight: 800; font-size: 30rpx; }
.fm-mebtn {
  background: var(--surf);
  border: 2rpx dashed var(--pri);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--pri-ink);
}
.fm-h { font-size: 22rpx; color: var(--ink3); margin-top: 12rpx; line-height: 1.6; }

/* ---------- 身份未认领时的提示条 ---------- */
.who-hint {
  margin: 0 0 18rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-card);
  background: var(--acc-l);
  color: var(--acc-ink);
  font-size: 25rpx;
  font-weight: 600;
}

/* ---------- 标题旁的版本标记（真机排查用） ---------- */
.ver {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink3);
  margin-left: 12rpx;
  letter-spacing: 0;
}

/* ---------- 成员编辑弹层：内容滚动，按钮不被挤走 ---------- */
.fs-scroll {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}
.fs-actions { flex: 0 0 auto; }

/* ---------- 深色下的「浅底小标签」 ----------
   深色主题里 --pri-l / --ok-l 都是 16% 的白，而 --pri-ink 是纯白、--ok-ink 是深绿，
   所以「浅底 + 同色字」这类小标签（食材签、步骤号、「我」标记）会糊成一片。
   统一换成暖色（柿橙底 + 暖白字）—— 和日历的 .up-clip、管理页的 .op-edit 一套处理。
   注意两种深色路径都要覆盖：手动选深色是 .theme-dark，跟随系统走媒体查询。 */
.theme-dark .mem-me { background: var(--acc-l); color: var(--acc-ink); }
@media (prefers-color-scheme: dark) {
  .mem-me { background: var(--acc-l); color: var(--acc-ink); }
}
