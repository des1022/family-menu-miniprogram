.hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 4rpx 20rpx;
}
.hd-copy {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink2);
}

/* ---------- 进度 ---------- */
.prog { margin-bottom: 24rpx; }
.prog-hd {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 25rpx;
  color: var(--ink2);
  font-weight: 600;
  margin-bottom: 12rpx;
}
.prog-n { font-size: 32rpx; font-weight: 800; color: var(--pri-ink); }
.prog-who { font-size: 23rpx; color: var(--acc-ink); }
.prog-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--surf2);
  overflow: hidden;
}
.prog-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--btn-bg);
  transition: width 0.25s;
}

/* ---------- 分组 ---------- */
/* 一个分组一张卡，组内条目用分隔线 ——「清单感」来自容器，不来自条目。
   同样 4 项内容，这样比「每项一张独立卡」更矮、更像一张采购单（2026-10-12）。 */
.gcard {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: var(--r-card);
  box-shadow: var(--sh);
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.ghd {
  display: flex; align-items: center; gap: 14rpx;
  padding: 24rpx 0 18rpx;
  font-size: 24rpx; font-weight: 700; color: var(--ink2);
  letter-spacing: 0.06em;
}
/* 分组前的小图标：蔬菜 / 肉蛋 / 水产 / 调味 / 主食 / 其他（复用菜库那套的配色） */
.ghd-ic { width: 36rpx; height: 36rpx; flex: 0 0 auto; }
.ghd-nm { flex: 0 0 auto; }
.gcnt {
  font-size: 21rpx; font-weight: 700;
  color: var(--pri-ink); background: var(--pri-l);
  border-radius: 999rpx; padding: 2rpx 14rpx;
  letter-spacing: 0;
}
/* 深色里 --pri-l 是 16% 的白、--pri-ink 是纯白 → 白字压浅白看不清，换暖色兜底 */
.theme-dark .gcnt { background: var(--acc-l); color: var(--acc-ink); }
@media (prefers-color-scheme: dark) {
  .gcnt { background: var(--acc-l); color: var(--acc-ink); }
}
.grow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--line);
}
.cb {
  width: 40rpx; height: 40rpx; flex: 0 0 auto;
  border-radius: 12rpx;
  border: 3rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ok-ink);
}
.grow--done .cb { background: var(--ok); border-color: var(--ok); }
.theme-dark .grow--done .cb { color: #2A5F54; }
@media (prefers-color-scheme: dark) {
  .grow--done .cb { color: #2A5F54; }
}
.item-nm { flex: 1; font-size: 30rpx; font-weight: 600; }
.grow--done .item-nm {
  color: var(--ink3);
  text-decoration: line-through;
}
.item-qty { font-size: 25rpx; color: var(--ink2); font-weight: 600; }
.grow--done .item-qty { color: var(--ink3); }
.item-by { font-size: 22rpx; color: var(--ink3); }

/* ---------- 常备 ---------- */
.staple-hd {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 30rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--ink2);
  font-weight: 600;
}
.staple-arw { font-size: 20rpx; color: var(--ink3); }

/* ---------- 提示 ---------- */
.tip {
  font-size: 22rpx;
  color: var(--ink3);
  line-height: 1.7;
  padding: 30rpx 4rpx 10rpx;
}

/* ---------- 添加弹层表单 ---------- */
.fm { margin-bottom: 28rpx; }
.fm-l { font-size: 24rpx; font-weight: 700; color: var(--ink2); margin-bottom: 14rpx; }
.fm-input {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  /* 同 family 页：原生 input 不给高度 + 有上下 padding 会把输入区压扁 */
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--ink);
}
.fm-ph { color: var(--ink3); }
