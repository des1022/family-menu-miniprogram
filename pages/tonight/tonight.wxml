<view class="page page--tab {{themeCls}}">
  <view class="page-body">

    <!-- 页头 -->
    <view class="hd">
      <view>
        <view class="t-h1">今晚</view>
        <view class="t-sub">{{dateText}}</view>
      </view>
      <view class="avars">
        <view class="avar" wx:for="{{members}}" wx:key="_id" style="background:{{item.color}}" wx:if="{{index < 4}}">{{item.initial}}</view>
      </view>
    </view>

    <!-- ============ 云环境未初始化：直接告诉用户要做什么 ============ -->
    <view class="setup" wx:if="{{env.checked && !env.ready}}">
      <view class="setup-t">云环境还没初始化</view>
      <view class="setup-s">
        这个云开发环境里还没有数据表，所以什么都存不进去。建完下面 {{env.missing.length}} 个集合就能用了。
      </view>

      <view class="setup-list">
        <view class="setup-i" wx:for="{{env.items}}" wx:key="raw">
          <text class="setup-mark {{item.ok ? 'setup-mark--ok' : ''}}">{{item.ok ? '✓' : '✕'}}</text>
          <text class="setup-nm">{{item.raw}}</text>
          <text class="setup-lb">{{item.name}}</text>
        </view>
      </view>

      <view class="setup-steps">
        <view class="setup-sh">怎么做（约 2 分钟）</view>
        <view class="setup-step">1. 微信里搜索小程序 <text class="setup-em">云开发 CloudBase</text>，用你自己的微信打开</view>
        <view class="setup-step">2. 选环境 <text class="setup-em">{{envId}}</text></view>
        <view class="setup-step">3. 「数据库 → 集合管理 → 新建集合」，把上面 5 个名字逐个建出来</view>
        <view class="setup-step">4. 每个集合的权限都改成 <text class="setup-em">所有用户可读写</text>（默认是「仅创建者可读写」）</view>
        <view class="setup-step">5. 回来点「重新检查」</view>
      </view>

      <view class="btn-row">
        <view class="btn btn-ghost" bindtap="onCopyCollections">复制集合名</view>
        <view class="btn btn-primary" bindtap="onRecheckEnv">重新检查</view>
      </view>
    </view>

    <!-- 今晚在家吃 -->
    <view class="eatro" wx:if="{{members.length}}">
      <text class="eatro-l">今晚在家吃</text>
      <view class="avars">
        <view class="avar {{item.eatTonight ? '' : 'avar--off'}}" wx:for="{{members}}" wx:key="_id" style="background:{{item.color}}" wx:if="{{index < 5}}">{{item.initial}}</view>
      </view>
      <text class="eatro-v">{{eatCount}} 人</text>
    </view>

    <!-- ============ 未点：引导 ============ -->
    <block wx:if="{{env.ready && !cards.length}}">
      <view class="hero-q">今晚<text class="hero-q-hl">吃什么？</text></view>

      <view class="dash">
        <image class="dash-ico" src="{{ico.bowl}}"/>
        <view class="dash-t">今晚还没点菜</view>
        <view class="dash-s">让家里一起点，或者我帮你选一顿</view>
      </view>

      <button class="big-btn big-btn--primary" open-type="share">
        <view class="bb-ic"><image class="bb-img" src="{{ico.share}}"/></view>
        <view class="bb-tx">
          <view class="bb-t">让家里点菜</view>
          <view class="bb-s">分享到家庭群，每人点一道</view>
        </view>
      </button>

      <view class="big-btn big-btn--ghost" bindtap="onPickForMe">
        <view class="bb-ic"><image class="bb-img" src="{{ico.dice}}"/></view>
        <view class="bb-tx">
          <view class="bb-t">帮我选一顿</view>
          <view class="bb-s">{{pickHint}}</view>
        </view>
      </view>

      <block wx:if="{{recent.length}}">
        <view class="sec-h"><text class="sec-t">最近家里常吃</text><text class="sec-m" bindtap="goDishes">看全部 ›</text></view>
        <scroll-view class="hscroll" scroll-x enable-flex show-scrollbar="{{false}}">
          <view class="mini" wx:for="{{recent}}" wx:key="_id" data-id="{{item._id}}" bindtap="onQuickAdd" hover-class="mini--hover">
            <image class="mini-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/>
            <view class="mini-img img-ph {{item.ph}}" wx:else>{{item.initial}}</view>
            <view class="mini-nm ellipsis">{{item.name}}</view>
            <view class="mini-sub ellipsis">{{item.freqText}}</view>
          </view>
        </scroll-view>
      </block>

      <view class="seed-card" wx:if="{{!allCount}}">
        <view class="seed-t">还没有菜品？</view>
        <view class="seed-s">一键填入 12 道家常菜，马上就能用</view>
        <view class="btn btn-primary btn-block" bindtap="onSeed">填入示例菜库</view>
      </view>
    </block>

    <!-- ============ 已点：今晚的桌 ============ -->
    <block wx:elif="{{env.ready}}">
      <view class="sec-h">
        <text class="sec-t">今晚的桌 · {{cards.length}} 道</text>
        <text class="sec-m" bindtap="goDishes">再加一道 ›</text>
      </view>

      <view class="g2">
        <view class="dish" wx:for="{{cards}}" wx:key="id">
          <image class="dish-img dish-dim" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" data-id="{{item.dishId}}" bindtap="onOpenDish"/>
          <view class="dish-img img-ph {{item.ph}}" wx:else data-id="{{item.dishId}}" bindtap="onOpenDish">{{item.initial}}</view>
          <view class="owner" wx:if="{{item.byName}}">
            <view class="owner-dot" style="background:{{item.byColor}}"></view>
            <text>{{item.byName}}</text>
          </view>
          <view class="dish-body">
            <view class="dish-nm ellipsis">{{item.name}}</view>
            <view class="dish-tg">
              <text class="tag" wx:if="{{item.category}}">{{item.category}}</text>
              <text class="tag tag--ok" wx:if="{{item.confirmed}}">已确认</text>
              <text class="tag tag--how" wx:if="{{item.hasSteps}}" catchtap="onOpenHow" data-id="{{item.dishId}}">做法</text>
            </view>
          </view>
          <view class="dish-x" catchtap="onRemove" data-id="{{item.dishId}}" data-name="{{item.name}}">✕</view>
        </view>
      </view>

      <view class="sug" wx:if="{{suggest}}">
        <view class="sug-tx">{{suggest.text}}<text class="sug-hint">{{suggest.hint}}</text></view>
        <view class="sug-go" bindtap="onSugTap">去看看</view>
      </view>

      <view class="row-card" bindtap="onOpenShopping">
        <view class="rc-ic"><image class="rc-img" src="{{ico.basket}}"/></view>
        <view class="rc-main">
          <view class="rc-t">今日采购清单</view>
          <view class="rc-s">{{ingCount ? ingCount + ' 种食材 · 可勾选、可加项' : '给菜品补上食材，这里就能自动汇总'}}</view>
        </view>
        <text class="rc-arw">›</text>
      </view>

      <view class="row-card" bindtap="goPoster">
        <view class="rc-ic"><image class="rc-img" src="{{ico.download}}"/></view>
        <view class="rc-main">
          <view class="rc-t">生成今日海报</view>
          <view class="rc-s">4 套模板，可保存到相册发家庭群</view>
        </view>
        <text class="rc-arw">›</text>
      </view>
    </block>

  </view>

  <!-- 底部固定操作 -->
  <view class="fixbar" wx:if="{{cards.length}}">
    <view class="btn-row">
      <button class="btn btn-ghost" open-type="share">分享</button>
      <view class="btn btn-primary {{busy ? 'btn-disabled' : ''}}" bindtap="onConfirmTonight">确认这顿饭</view>
    </view>
  </view>

  <!-- 做法弹层 -->
  <view class="sheet-mask" wx:if="{{how}}" bindtap="closeHow" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-grab"></view>
      <view class="sheet-hd">
        <text class="sheet-t">{{how.name}}</text>
        <view class="sheet-x" bindtap="closeHow">✕</view>
      </view>

      <scroll-view class="hw-scroll" scroll-y>
        <view class="hw-tags">
          <text class="tag" wx:if="{{how.category}}">{{how.category}}</text>
          <text class="tag">{{how.stepList.length}} 步</text>
        </view>

        <view class="hw-sec" wx:if="{{how.ingList.length}}">
          <view class="hw-h">食材</view>
          <view class="hw-ing">
            <text class="hw-ing-i" wx:for="{{how.ingList}}" wx:key="*this">{{item}}</text>
          </view>
        </view>

        <view class="hw-sec">
          <view class="hw-h">做法</view>
          <view class="hw-steps">
            <view class="hw-step" wx:for="{{how.stepList}}" wx:key="index">
              <text class="hw-step-n">{{index + 1}}</text>
              <text class="hw-step-t">{{item}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="btn-row" style="margin-top:26rpx">
        <view class="btn btn-ghost" bindtap="onCopyHow">复制做法</view>
        <view class="btn btn-primary" bindtap="closeHow">开始做</view>
      </view>
    </view>
  </view>

  <!-- 帮我选一顿（决策器） -->
  <view class="sheet-mask" wx:if="{{dec.open}}" bindtap="closeDec" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-grab"></view>
      <view class="sheet-hd">
        <text class="sheet-t">帮你选一顿</text>
        <view class="sheet-x" bindtap="closeDec">✕</view>
      </view>
      <view class="dec-sub">从你家菜库里挑的，久没做过的优先</view>

      <view class="dec-row">
        <view class="dec-l">搭配</view>
        <view class="dec-chips">
          <view
            class="chip {{dec.mix === item.key ? 'chip--on' : ''}}"
            wx:for="{{mixes}}"
            wx:key="key"
            data-field="mix"
            data-value="{{item.key}}"
            bindtap="onPickDecOpt"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="dec-row">
        <view class="dec-l">人数</view>
        <view class="dec-chips">
          <view
            class="chip {{dec.size === item.key ? 'chip--on' : ''}}"
            wx:for="{{sizes}}"
            wx:key="key"
            data-field="size"
            data-value="{{item.key}}"
            bindtap="onPickDecOpt"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="dec-row">
        <view class="dec-l">口味</view>
        <view class="dec-chips">
          <view
            class="chip {{dec.taste === item.key ? 'chip--on' : ''}}"
            wx:for="{{tastes}}"
            wx:key="key"
            data-field="taste"
            data-value="{{item.key}}"
            bindtap="onPickDecOpt"
          >{{item.label}}</view>
        </view>
      </view>

      <scroll-view class="dec-list" scroll-y>
        <view class="dec-pick" wx:for="{{dec.picks}}" wx:key="_id">
          <image class="dp-img dish-dim" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/>
          <view class="dp-img img-ph {{item.ph}}" wx:else>{{item.initial}}</view>
          <view class="dp-main">
            <view class="dp-nm">{{item.name}}</view>
            <view class="dp-mt">{{item.roleLabel}}{{item.category ? ' · ' + item.category : ''}} · {{item.lastText}}</view>
          </view>
          <view class="dp-swap" data-idx="{{index}}" catchtap="onSwapOne">换一个</view>
        </view>
      </scroll-view>

      <view class="btn-row dec-actions">
        <view class="btn btn-ghost" bindtap="rollAll">全部重摇</view>
        <view class="btn btn-primary {{busy ? 'btn-disabled' : ''}}" bindtap="onConfirmDec">就这些，定了</view>
      </view>
    </view>
  </view>

  <!-- 首次引导 -->
  <view class="sheet-mask" wx:if="{{guide}}" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-grab"></view>
      <view class="sheet-hd"><text class="sheet-t">欢迎使用家庭菜单</text></view>
      <view class="guide-i">
        <text class="guide-n">1</text>
        <text class="guide-t">在「菜库」挑菜加进今晚，全家实时同步</text>
      </view>
      <view class="guide-i">
        <text class="guide-n">2</text>
        <text class="guide-t">拿不准就让「帮我选一顿」掷一把</text>
      </view>
      <view class="guide-i">
        <text class="guide-n">3</text>
        <text class="guide-t">点「确认这顿饭」，日历里就留下这一桌了</text>
      </view>
      <view class="btn btn-primary btn-block" bindtap="onCloseGuide">开始用</view>
    </view>
  </view>

  <!-- 本机认不出「我是谁」：让用户指认，而不是默默新建一条重复成员 -->
  <who
    show="{{whoShow}}"
    members="{{whoList}}"
    bindpick="onWhoPick"
    bindcreate="onWhoCreate"
    bindclose="onWhoClose"
  />
</view>
