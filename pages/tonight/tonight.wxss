/* ==================== 页头 ==================== */
.hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 4rpx 20rpx;
}
/* 标题从「今晚」换成了一句 9 个字的文案，左块要能吃剩余宽度、不允许把头像挤走 */
.hd-main { flex: 1; min-width: 0; }

.avars { display: flex; align-items: center; flex: 0 0 auto; }
.avar {
  width: 52rpx; height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid var(--bg);
  margin-left: -16rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 22rpx; font-weight: 700;
}
.avar:first-child { margin-left: 0; }
.avar--off { opacity: 0.32; }

/* ==================== 今晚在家吃 ==================== */
.eatro {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-shadow: var(--sh);
}
.eatro-l { font-size: 26rpx; color: var(--ink2); }
.eatro-v { margin-left: auto; font-size: 30rpx; font-weight: 700; color: var(--pri-ink); }

/* ==================== 未点态 ==================== */
.hero-q {
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin: 40rpx 4rpx 34rpx;
}
.hero-q-hl { color: var(--pri-ink); }

/* ---------- 空态：一二 & 布布插画垫底 ---------- */
/* 卡片尺寸与文字位置与原来的「今晚还没点菜」完全一致，只是把底色换成插画。
   注意：插画必须用 <image> 组件 —— 小程序 WXSS 的 background-image
   不支持本地路径（写了也会被静默忽略，表现就是「图片没出来」）。 */
.hero {
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--line);
  border-radius: var(--r-card);
  /* 上内边距 152rpx = 原来「碗图标 96 + 间距 12 + 上内边距 44」，
     这样标题仍落在原来的位置；下方 44rpx 与原内边距一致。 */
  padding: 152rpx 28rpx 44rpx;
  text-align: center;
  background: var(--surf);
  box-shadow: var(--sh);
}
.hero-bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
/* 文字压图时压一层薄雾，保证两行字在任何颜色上都读得清 */
.hero-veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: var(--hero-veil);
  z-index: 1;
}
.hero-t, .hero-s { position: relative; z-index: 2; }
.hero-t { font-size: 30rpx; font-weight: 700; }
.hero-s { font-size: 25rpx; color: var(--ink2); margin-top: 8rpx; }

/* 大动作按钮 */
.big-btn {
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-radius: var(--r-card);
  padding: 28rpx 26rpx;
  margin-top: 22rpx;
  width: 100%;
  text-align: left;
  line-height: 1.4;
  border: none;
}
.big-btn::after { border: none; }
.big-btn--primary {
  background: var(--btn-bg);
  color: var(--btn-ink);
  box-shadow: var(--btn-sh);
}
.big-btn--ghost {
  background: var(--surf);
  border: 2rpx solid var(--line);
  color: var(--ink);
  box-shadow: var(--sh);
}
.bb-ic {
  width: 76rpx; height: 76rpx; flex: 0 0 auto;
  border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255, 255, 255, 0.22);
}
.big-btn--ghost .bb-ic { background: var(--acc-l); }
.bb-img { width: 40rpx; height: 40rpx; }
.bb-tx { flex: 1; }
.bb-t { font-size: 32rpx; font-weight: 700; }
.bb-s { font-size: 24rpx; opacity: 0.8; margin-top: 4rpx; }

/* 横滑小卡 */
.hscroll { white-space: nowrap; width: 100%; }
.mini {
  position: relative;
  display: inline-block;
  width: 210rpx;
  margin-right: 18rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: var(--sh);
  vertical-align: top;
}
.mini--hover { opacity: 0.8; }
/* 已在今晚的菜：右上角对勾 + 绿描边，点一下可以撤掉 */
.mini--on { border-color: var(--ok); }
.mini--on::after {
  content: '✓';
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--ok);
  color: var(--surf);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  z-index: 2;
}
.mini--on .mini-sub { color: var(--ok-ink); font-weight: 600; }
.mini-img { width: 100%; height: 132rpx; font-size: 34rpx; }
.mini-nm { font-size: 25rpx; font-weight: 700; padding: 14rpx 16rpx 0; }
.mini-sub { font-size: 20rpx; color: var(--ink2); padding: 4rpx 16rpx 16rpx; }

/* 示例菜库引导卡 */
.seed-card {
  margin-top: 34rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: var(--r-card);
  padding: 30rpx 28rpx;
  box-shadow: var(--sh);
}
.seed-t { font-size: 30rpx; font-weight: 700; }
.seed-s { font-size: 25rpx; color: var(--ink2); margin: 8rpx 0 22rpx; }

/* ==================== 已点态 · 菜品卡墙 ==================== */
.g2 { display: flex; flex-wrap: wrap; margin: 0 -9rpx; }
.dish {
  position: relative;
  width: calc(50% - 18rpx);
  margin: 9rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: var(--sh);
}
.dish-img { width: 100%; height: 200rpx; font-size: 48rpx; }
.dish-body { padding: 16rpx 18rpx 20rpx; }
.dish-nm { font-size: 27rpx; font-weight: 700; }
.dish-tg { display: flex; gap: 8rpx; margin-top: 10rpx; flex-wrap: wrap; }
.owner {
  position: absolute;
  left: 14rpx; top: 14rpx;
  display: flex; align-items: center; gap: 8rpx;
  background: var(--owner-bg);
  color: var(--owner-ink);
  border-radius: 999rpx;
  padding: 4rpx 16rpx 4rpx 6rpx;
  font-size: 20rpx; font-weight: 700;
}
.owner-dot { width: 28rpx; height: 28rpx; border-radius: 50%; }
.dish-x {
  position: absolute;
  right: 10rpx; top: 10rpx;
  width: 46rpx; height: 46rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.34);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}

/* ==================== 搭配建议 ==================== */
.sug {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--acc-l);
  border: 2rpx solid var(--acc);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-top: 26rpx;
}
.sug-tx { flex: 1; font-size: 25rpx; font-weight: 700; color: var(--acc-ink); line-height: 1.5; }
.sug-hint { display: block; font-size: 22rpx; font-weight: 500; opacity: 0.82; }
.sug-go {
  flex: 0 0 auto;
  background: var(--acc);
  color: #fff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  font-weight: 700;
}

/* ==================== 食材入口卡 ==================== */
.row-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  margin-top: 22rpx;
  box-shadow: var(--sh);
}
.rc-ic {
  width: 68rpx; height: 68rpx; flex: 0 0 auto;
  border-radius: 20rpx;
  background: var(--pri-l);
  display: flex; align-items: center; justify-content: center;
}
.rc-img { width: 38rpx; height: 38rpx; }
.rc-main { flex: 1; }
.rc-t { font-size: 29rpx; font-weight: 700; }
.rc-s { font-size: 23rpx; color: var(--ink2); margin-top: 4rpx; }
.rc-arw { color: var(--ink3); font-size: 34rpx; }

/* ==================== 食材清单弹层 ==================== */
.ing-list { max-height: 50vh; margin-bottom: 20rpx; }
.ing-i {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 4rpx;
  border-bottom: 2rpx solid var(--line);
}
.ing-n { font-size: 29rpx; font-weight: 600; flex: 0 0 auto; }
.ing-d { font-size: 22rpx; color: var(--ink2); flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ing-t { font-size: 24rpx; color: var(--ink2); font-weight: 600; }
.ing-empty { padding: 60rpx 20rpx; text-align: center; font-size: 26rpx; color: var(--ink2); line-height: 1.7; }

/* ==================== 引导 ==================== */
.guide-i { display: flex; gap: 18rpx; padding: 18rpx 0; align-items: flex-start; }
.guide-n {
  width: 44rpx; height: 44rpx; flex: 0 0 auto;
  border-radius: 14rpx;
  background: var(--pri-l);
  color: var(--pri-ink);
  font-size: 24rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.guide-t { font-size: 27rpx; line-height: 1.6; padding-top: 4rpx; }

/* ==================== 决策器 ==================== */
/* 高度分配要算准：参数区（3 行）+ 结果列表 + 底部按钮 必须同时放得下，
   否则「就这些，定了」会被顶到屏幕外（真机反馈过「确认不了」）。
   固定部分约 660rpx，列表按 28vh 留白 —— 矮屏也不会溢出。 */
.dec-sub {
  font-size: 23rpx;
  color: var(--ink2);
  text-align: center;
  margin: 0 0 16rpx;
}
.dec-row { margin-bottom: 12rpx; }
.dec-l {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink2);
  letter-spacing: 0.06em;
  margin-bottom: 8rpx;
}
.dec-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
/* flex:0 0 auto 很关键 —— 不加的话 scroll-view 默认 flex-shrink:1，
   在只有 max-height 的父容器里会被内容撑高，把底部按钮挤出去 */
.dec-list {
  flex: 0 0 auto;
  max-height: 28vh;
  padding: 6rpx 0 2rpx;
}
.dec-pick {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--sh);
}
.dp-img { width: 112rpx; height: 112rpx; border-radius: 20rpx; flex: 0 0 auto; font-size: 38rpx; }
.dp-main { flex: 1; min-width: 0; }
.dp-nm { font-size: 30rpx; font-weight: 700; }
.dp-mt { font-size: 22rpx; color: var(--ink2); margin-top: 6rpx; }
.dp-swap {
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink2);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}
.dec-actions { margin-top: 22rpx; flex: 0 0 auto; }

/* ==================== 云环境未初始化引导 ==================== */
.setup {
  margin: 8rpx 0 28rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--acc);
  border-radius: var(--r-card);
  padding: 30rpx 28rpx;
  box-shadow: var(--sh);
}
.setup-t { font-size: 33rpx; font-weight: 700; }
.setup-s { font-size: 25rpx; color: var(--ink2); line-height: 1.6; margin: 10rpx 0 22rpx; }
.setup-list {
  background: var(--surf2);
  border-radius: 18rpx;
  padding: 8rpx 18rpx;
  margin-bottom: 22rpx;
}
.setup-i { display: flex; align-items: center; padding: 12rpx 0; }
.setup-mark { width: 34rpx; flex: 0 0 auto; font-size: 26rpx; font-weight: 700; color: var(--danger); }
.setup-mark--ok { color: var(--ok); }
.setup-nm { flex: 1; font-size: 27rpx; font-family: monospace; color: var(--ink); }
.setup-lb { font-size: 23rpx; color: var(--ink3); }
.setup-steps { margin-bottom: 24rpx; }
.setup-sh { font-size: 25rpx; font-weight: 700; color: var(--ink2); margin-bottom: 12rpx; }
.setup-step { font-size: 24rpx; color: var(--ink2); line-height: 1.75; }
.setup-em { font-weight: 700; color: var(--pri); }

/* ==================== 做法 ==================== */
.tag--how {
  background: var(--acc-l);
  color: var(--acc-ink);
}
.hw-scroll {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}
.hw-tags { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.hw-sec { margin-bottom: 24rpx; }
.hw-h {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink2);
  letter-spacing: 0.08em;
  margin-bottom: 12rpx;
}
.hw-ing { display: flex; flex-wrap: wrap; gap: 12rpx; }
.hw-ing-i {
  font-size: 24rpx;
  font-weight: 600;
  background: var(--ok-l);
  color: var(--ok-ink);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.hw-steps {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 6rpx 24rpx;
}
.hw-step {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.hw-step:last-child { border-bottom: none; }
.hw-step-n {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--pri-l);
  color: var(--pri-ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
}
.hw-step-t {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.65;
  color: var(--ink);
}
