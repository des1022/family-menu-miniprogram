/* ===== 搜索 ===== */
.search-wrap {
  padding: 20rpx 24rpx 8rpx;
  background: #FF7A45;
}

.search-box {
  position: relative;
  height: 76rpx;
  background: #fff;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.search-ph {
  font-size: 28rpx;
  color: #B4B9C0;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  color: #1F2329;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #B4B9C0;
}

/* ===== 分类标签栏 ===== */
.cat-bar {
  background: #FF7A45;
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.cat-inner {
  display: inline-flex;
  padding: 0 24rpx;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
}

.cat-item--active {
  background: #fff;
  color: #FF7A45;
  font-weight: 600;
}

/* ===== 菜品列表 ===== */
.dish-list {
  padding: 20rpx 24rpx 0;
}

/* ===== 首次引导 ===== */
.guide-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.guide-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
}

.guide-title {
  font-size: 38rpx;
  font-weight: 600;
  text-align: center;
  color: #1F2329;
  margin-bottom: 36rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.guide-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFF3ED;
  color: #FF7A45;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.guide-text {
  font-size: 30rpx;
  color: #4E5969;
  flex: 1;
}


/* ===== 标签筛选行 ===== */
.tag-bar {
  padding-bottom: 4rpx;
}

.cat-item--tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
}

.cat-item--clear {
  color: #B4B9C0;
  border: 2rpx dashed #D9DCE0;
  background: #FAFBFC;
}
