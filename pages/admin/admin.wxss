.page {
  padding: 24rpx 24rpx 180rpx;
}

.filter-bar {
  margin-bottom: 16rpx;
}

.filter-inner {
  display: flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.filter-chip {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surf);
  color: var(--ink2);
  font-size: 26rpx;
  border: 2rpx solid var(--line);
}

.filter-chip--on {
  background: var(--pri);
  /* 原来写的是 var(--surf)：那是「表面色」不是「文字色」，
     浅色下碰巧等于白色所以看不出问题，深色下会变成墨绿字压白底 */
  color: var(--btn-ink);
  border-color: var(--pri);
  font-weight: 600;
}

.group {
  margin-bottom: 20rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink2);
  padding: 8rpx 8rpx 12rpx;
}

.manage-row {
  display: flex;
  align-items: center;
  background: var(--surf);
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--sh);
}

.manage-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: var(--surf2);
  flex-shrink: 0;
}

.manage-info {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.manage-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.manage-status {
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--surf2);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.manage-status--on {
  color: var(--ok-ink);
  background: var(--ok-l);
}

.manage-price {
  font-size: 24rpx;
  color: var(--pri-ink);
  font-weight: 600;
}

.manage-ops {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.op-btn {
  font-size: 24rpx;
  text-align: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  /* 三个操作按钮统一：浅底、无边框，靠文字颜色区分（原来的灰白底 + 描边在深色下很脏） */
  border: 2rpx solid transparent;
  color: var(--ink2);
  background: var(--surf2);
}

.op-edit {
  color: var(--pri-ink);
  background: var(--pri-l);
}
/* 深色下 --pri-l 是半透明白、--pri-ink 是白色，白字压半透明白对比度不够，
   所以深色里改用暖色（柿子橙），和浅色下一样是「暖＝可操作」 */
.theme-dark .op-edit { background: var(--acc-l); color: var(--acc-ink); }
@media (prefers-color-scheme: dark) {
  .op-edit { background: var(--acc-l); color: var(--acc-ink); }
}

.op-del {
  color: var(--danger);
  background: var(--surf2);
}

/* 「上架 / 下架」这一颗以前没有样式（wxml 里挂着 op-toggle 但全项目没定义），
   结果最要紧的那个动作反而长得最弱（默认的灰底灰字）。
   它既不是「主操作」也不是「删除」，而且文案会随状态翻转，所以用琥珀＝提醒级：
   「这一下会改变它在菜库/点菜里出不出现」。 */
.op-toggle {
  color: var(--acc-ink);
  background: var(--acc-l);
}
/* 深色下 --acc 系本来就是暖白字压暖底，不用再改；这里只兜一层，防止以后有人换色值 */
.theme-dark .op-toggle { background: var(--acc-l); color: var(--acc-ink); }
@media (prefers-color-scheme: dark) {
  .op-toggle { background: var(--acc-l); color: var(--acc-ink); }
}

.admin-ft {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surf);
  padding: 16rpx 24rpx;
  display: flex;
  gap: 20rpx;
  /* 底部固定栏：用一条 --line 细线收口，比写死的灰色投影干净，也跟着主题走 */
  border-top: 2rpx solid var(--line);
}

.btn-flex {
  flex: 1;
}


/* ===== 批量模式 ===== */
.batch-bar {
  display: flex;
  align-items: center;
  background: var(--surf);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
}

.batch-info {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}

.batch-btn {
  font-size: 26rpx;
  color: var(--ink2);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  margin-left: 12rpx;
}

.batch-btn--on {
  color: var(--btn-ink);
  background: var(--pri);
  border-color: var(--pri);
  font-weight: 600;
}

.manage-row--checked {
  background: var(--pri-l);
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  margin-right: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--btn-ink);
  font-size: 24rpx;
}

.check-circle--on {
  background: var(--pri);
  border-color: var(--pri);
}

.op-btn-ft {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
}

.move-mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 20, 14, 0.45);
  z-index: 120;
  display: flex;
  align-items: flex-end;
}

.move-sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 24rpx 32rpx;
}

.move-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.move-list {
  max-height: 50vh;
  margin-bottom: 16rpx;
}

.move-item {
  background: var(--surf);
  border-radius: 14rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  color: var(--ink);
  text-align: center;
}
