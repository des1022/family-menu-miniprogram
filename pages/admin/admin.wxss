.page {
  padding: 24rpx 24rpx 180rpx;
}

.filter-bar {
  margin-bottom: 16rpx;
}

.filter-inner {
  display: flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.filter-chip {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surf);
  color: var(--ink2);
  font-size: 26rpx;
  border: 2rpx solid var(--line);
}

.filter-chip--on {
  background: var(--pri);
  color: var(--surf);
  border-color: var(--pri);
  font-weight: 600;
}

.group {
  margin-bottom: 20rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2E24;
  padding: 8rpx 8rpx 12rpx;
}

.manage-row {
  display: flex;
  align-items: center;
  background: var(--surf);
  border-radius: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(31, 35, 41, 0.04);
}

.manage-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: var(--surf2);
  flex-shrink: 0;
}

.manage-info {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.manage-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manage-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.manage-status {
  font-size: 22rpx;
  color: var(--ink2);
  background: var(--surf2);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.manage-status--on {
  color: #52A256;
  background: #E9F6EA;
}

.manage-price {
  font-size: 24rpx;
  color: var(--pri);
}

.manage-ops {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.op-btn {
  font-size: 24rpx;
  text-align: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  color: var(--ink2);
  background: #FAFBFC;
}

.op-edit {
  color: var(--pri);
  border-color: #FFC9AE;
  background: #FFF0E8;
}

.op-del {
  color: #C0392B;
  border-color: #F5C6C0;
  background: #FDF3F2;
}

.admin-ft {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surf);
  padding: 16rpx 24rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.btn-flex {
  flex: 1;
}


/* ===== 批量模式 ===== */
.batch-bar {
  display: flex;
  align-items: center;
  background: var(--surf);
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
}

.batch-info {
  flex: 1;
  font-size: 28rpx;
  color: #3A2E24;
  font-weight: 600;
}

.batch-btn {
  font-size: 26rpx;
  color: var(--ink2);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  margin-left: 12rpx;
}

.batch-btn--on {
  color: var(--surf);
  background: var(--pri);
  border-color: var(--pri);
  font-weight: 600;
}

.manage-row--checked {
  background: #FFF0E8;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D9DCE0;
  margin-right: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--surf);
  font-size: 24rpx;
}

.check-circle--on {
  background: var(--pri);
  border-color: var(--pri);
}

.op-btn-ft {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
}

.move-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 120;
  display: flex;
  align-items: flex-end;
}

.move-sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 24rpx 32rpx;
}

.move-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.move-list {
  max-height: 50vh;
  margin-bottom: 16rpx;
}

.move-item {
  background: var(--surf);
  border-radius: 14rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  color: var(--ink);
  text-align: center;
}
