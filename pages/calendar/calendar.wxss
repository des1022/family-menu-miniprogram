.hd { padding: 24rpx 4rpx 8rpx; }

/* ---------- 月份切换 ---------- */
.calh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 18rpx 0 22rpx;
}
.calh-a {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--ink2);
  border-radius: 50%;
  background: var(--surf);
  border: 2rpx solid var(--line);
}
.calh-m { font-size: 34rpx; font-weight: 700; letter-spacing: -0.01em; }

/* ---------- 月概览 ---------- */
.calstat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--pri-l);
  border: 2rpx solid var(--pri);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 26rpx;
}
.calstat-n { font-size: 44rpx; font-weight: 800; color: var(--pri-ink); line-height: 1; }
.calstat-tx { font-size: 25rpx; color: var(--ink); line-height: 1.5; }
.calstat-hl { font-weight: 700; }

/* ---------- 日期网格 ---------- */
.calgrid { display: flex; flex-wrap: wrap; }
.calgrid .wd {
  width: 14.28%;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
  font-weight: 600;
  padding-bottom: 10rpx;
}
.cell {
  width: 14.28%;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  border-radius: 18rpx;
}
.cell--blank { visibility: hidden; }
.cell--today { background: var(--pri); }
.theme-dark .cell--today { background: #FFFFFF; }
@media (prefers-color-scheme: dark) {
  .cell--today { background: #FFFFFF; }
}
.cell-d { font-size: 27rpx; font-weight: 600; color: var(--ink); line-height: 1.25; }
.cell--today .cell-d { color: var(--btn-ink); font-weight: 800; }
.theme-dark .cell--today .cell-d { color: #2A5F54; }
@media (prefers-color-scheme: dark) {
  .cell--today .cell-d { color: #2A5F54; }
}
.cell-dots {
  display: flex;
  gap: 5rpx;
  margin-top: 7rpx;
  height: 12rpx;
  align-items: center;
}
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.cell--today .dot { outline: 2rpx solid rgba(255, 255, 255, 0.7); }

.cal-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  justify-content: center;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.lg { font-size: 21rpx; color: var(--ink2); display: flex; align-items: center; gap: 8rpx; }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; }
.lg-dot--today { background: var(--pri); }
.theme-dark .lg-dot--today { background: #FFFFFF; }
.lg-t { font-size: 21rpx; color: var(--ink3); }

/* ---------- 本月回顾 ---------- */
.rv-t { font-size: 26rpx; font-weight: 700; margin-bottom: 20rpx; }
.rv-tx { font-size: 26rpx; color: var(--ink2); line-height: 1.7; }
.rv-tip { background: var(--acc-l); border-color: var(--acc); }
.rv-tip .rv-tx { color: var(--acc-ink); font-weight: 600; }

.rank { margin-bottom: 22rpx; }
.rank:last-child { margin-bottom: 0; }
.rank-hd { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10rpx; }
.rank-nm { font-size: 27rpx; font-weight: 600; }
.rank-num { font-size: 23rpx; color: var(--ink2); font-weight: 600; }
.rank-bar { height: 14rpx; border-radius: 999rpx; background: var(--surf2); overflow: hidden; }
.rank-fill { height: 100%; border-radius: 999rpx; background: var(--btn-bg); }

.cat { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.cat:last-child { margin-bottom: 0; }
.cat-dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex: 0 0 auto; }
.cat-nm { font-size: 25rpx; width: 108rpx; flex: 0 0 auto; }
.cat-bar { flex: 1; height: 14rpx; border-radius: 999rpx; background: var(--surf2); overflow: hidden; }
.cat-fill { height: 100%; border-radius: 999rpx; }
.cat-pct { font-size: 23rpx; color: var(--ink2); width: 74rpx; text-align: right; font-weight: 600; }

/* ---------- 当天详情弹层 ---------- */
.dt-list { max-height: 52vh; margin-bottom: 22rpx; }
.dt-i {
  display: flex; align-items: center; gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.dt-i:last-child { border-bottom: none; }
.dt-thumb { width: 108rpx; height: 108rpx; border-radius: 20rpx; flex: 0 0 auto; font-size: 36rpx; }
.dt-main { flex: 1; min-width: 0; }
.dt-nm { font-size: 29rpx; font-weight: 700; }
.dt-sub { font-size: 23rpx; color: var(--ink2); margin-top: 6rpx; }

/* ---------- 日历页：操作提示 ---------- */
.cal-hint {
  font-size: 23rpx;
  color: var(--acc-ink);
  background: var(--acc-l);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin-top: 16rpx;
}

/* ---------- 「安排这一天」弹层 ---------- */
.arr-picked {
  white-space: nowrap;
  margin-bottom: 16rpx;
  flex: 0 0 auto;
}
.ap-i {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: var(--pri-l);
  color: var(--pri-ink);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.ap-x { font-size: 22rpx; opacity: 0.7; }

.arr-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 16rpx;
  flex: 0 0 auto;
}
.arr-sb-ico { width: 34rpx; height: 34rpx; flex: 0 0 auto; opacity: 0.5; }
.arr-input { flex: 1; font-size: 27rpx; color: var(--ink); }
.arr-ph { color: var(--ink3); }

.arr-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
  flex: 0 0 auto;
}
.arr-tab {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink2);
  background: var(--surf2);
}
.arr-tab--on { background: var(--pri); color: var(--btn-ink); }

/* 安排列表：行比「当天详情」更紧凑 */
.dt-list .dt-thumb { width: 92rpx; height: 92rpx; font-size: 32rpx; }

.ar-btn {
  width: 64rpx; height: 64rpx; flex: 0 0 auto;
  border-radius: 50%;
  background: var(--btn-bg);
  color: var(--btn-ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 700;
}
.ar-btn--on { background: var(--ok); }
.theme-dark .ar-btn--on { color: #2A5F54; }

.ar-empty {
  text-align: center;
  color: var(--ink3);
  font-size: 25rpx;
  padding: 60rpx 0;
}

.arr-actions { flex: 0 0 auto; margin-top: 22rpx; }

/* ---------- 接下来的安排 ---------- */
.up-i {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--line);
}
.up-i:last-child { border-bottom: none; }
.up-l { flex: 1; min-width: 0; }
.up-d { font-size: 27rpx; font-weight: 700; }
.up-n { font-size: 24rpx; color: var(--ink2); margin-top: 6rpx; line-height: 1.5; }
.up-arw { color: var(--ink3); font-size: 34rpx; line-height: 1; flex: 0 0 auto; }
.up-tip { font-size: 22rpx; color: var(--ink3); margin: -4rpx 0 8rpx 6rpx; }

/* ---------- 菜品详情（叠在安排弹层之上） ---------- */
.sheet-mask--top { z-index: 130; }
.ad-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
}
.ad-hero {
  width: 100%;
  height: 260rpx;
  border-radius: 26rpx;
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.ad-tags { display: flex; gap: 10rpx; flex-wrap: wrap; margin-bottom: 22rpx; }
.ad-sec { margin-bottom: 26rpx; }
.ad-h {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink2);
  letter-spacing: 0.08em;
  margin-bottom: 14rpx;
}
.ad-h-n { font-weight: 600; color: var(--ink3); margin-left: 8rpx; letter-spacing: 0; }
.ad-ing { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ad-ing-i {
  font-size: 24rpx;
  font-weight: 600;
  background: var(--ok-l);
  color: var(--ok-ink);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.ad-tx { font-size: 27rpx; color: var(--ink2); line-height: 1.6; }
.ad-steps {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 6rpx 24rpx;
}
.ad-step {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.ad-step:last-child { border-bottom: none; }
.ad-step-n {
  flex: 0 0 auto;
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  background: var(--pri-l);
  color: var(--pri-ink);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}
.ad-step-t { flex: 1; font-size: 28rpx; line-height: 1.62; color: var(--ink); }
