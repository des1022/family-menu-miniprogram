.hd { padding: 24rpx 4rpx 8rpx; }

/* ---------- 月历卡片（方案 B：格子块） ---------- */
/* 以前月份、星期、日期、图例全部直接铺在页面底色上，没有容器，所以显得「没设计」。
   现在整块收进一张白卡，和「接下来的安排」用同一套卡片语言。 */
.cal-card {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: var(--r-card);
  box-shadow: var(--sh);
  padding: 18rpx 16rpx 12rpx;
}

/* ---------- 月份切换 ---------- */
.calh {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 4rpx 14rpx;
}
.calh-a {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; color: var(--ink2);
  border-radius: 50%;
  background: var(--surf2);
}
.calh-m { font-size: 32rpx; font-weight: 700; letter-spacing: -0.01em; }

/* ---------- 月概览：暖色横幅 ---------- */
/* 原来是一条 --pri-l 浅橙底 + --pri 描边的卡，和下面的白卡一样重，
   「N 顿在家吃」这个最重要的数字也没跳出来。现在整条铺暖橙渐变、白字，
   左边大数字自己站着，右边「最爱」有了一块小位置（2026-10-12）。
   颜色直接用主按钮那套变量：浅色下暖橙渐变 + 白字，深色下自动变白底 + 深墨绿字。 */
.statbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--btn-bg);
  color: var(--btn-ink);
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(196, 85, 58, 0.22);
}
/* 深色下 --btn-bg 是白底，橙色投影压在白卡上会很脏，换成常规阴影 */
.theme-dark .statbar { box-shadow: var(--sh); }
@media (prefers-color-scheme: dark) {
  .statbar { box-shadow: var(--sh); }
}
.statbar-l { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.statbar-n { font-size: 64rpx; font-weight: 800; letter-spacing: -2rpx; line-height: 1; }
.statbar-u { font-size: 24rpx; opacity: 0.9; }
.statbar-r {
  flex: 0 0 auto;
  text-align: right;
  font-size: 21rpx;
  opacity: 0.85;
  line-height: 1.45;
}
/* 菜名可能很长（「青椒土豆丝炒肉」这种），限宽 + 省略号，别把左边的数字挤扁 */
.statbar-fav {
  display: block;
  max-width: 300rpx;
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 700;
  opacity: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 日期网格 ---------- */
.calgrid { display: flex; flex-wrap: wrap; }
.calgrid .wd {
  width: 14.28%;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
  font-weight: 600;
  padding-bottom: 10rpx;
}
/* 每个日期＝一个浅底方块。原来的「今天」是画在整格上的圆角色块，
   现在方块自己承担这个角色，所以格子的圆角/底色都搬进了 .tile。 */
.cell {
  width: 14.28%;
  padding: 4rpx;
}
.cell--blank { visibility: hidden; }
.tile {
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--surf2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}
.cell-d { font-size: 27rpx; font-weight: 600; color: var(--ink2); line-height: 1.2; }
/* 有记录的日子：暖色底 + 深字，一眼看出「这天排过菜」 */
.tile--rec { background: var(--acc-l); }
.tile--rec .cell-d { color: var(--acc-ink); font-weight: 700; }
/* 今天：实心主色（深色模式主色是白的，所以字要转深） */
.tile--today { background: var(--pri); }
.tile--today .cell-d { color: var(--btn-ink); font-weight: 800; }
.theme-dark .tile--today .cell-d { color: #2A5F54; }
@media (prefers-color-scheme: dark) {
  .tile--today .cell-d { color: #2A5F54; }
}
.cell-dots {
  display: flex;
  gap: 5rpx;
  height: 12rpx;
  align-items: center;
}
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
/* 深色模式下「今天」是白底，白描边会看不见，所以只留浅色模式的描边 */
.tile--today .dot { outline: 2rpx solid rgba(255, 255, 255, 0.7); }
.theme-dark .tile--today .dot { outline: none; }
@media (prefers-color-scheme: dark) {
  .tile--today .dot { outline: none; }
}

/* 图例挪进卡片底部，用一条细线隔开 */
.cal-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  justify-content: center;
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
  flex-wrap: wrap;
}
.lg { font-size: 21rpx; color: var(--ink2); display: flex; align-items: center; gap: 8rpx; }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; }
.lg-dot--rec { background: var(--acc); }
.lg-dot--today { background: var(--pri); }
.theme-dark .lg-dot--today { background: #FFFFFF; }
.lg-t { font-size: 21rpx; color: var(--ink3); }

/* ---------- 本月回顾 ---------- */
.rv-t { font-size: 26rpx; font-weight: 700; margin-bottom: 20rpx; }
.rv-tx { font-size: 26rpx; color: var(--ink2); line-height: 1.7; }
.rv-tip { background: var(--acc-l); border-color: var(--acc); }
.rv-tip .rv-tx { color: var(--acc-ink); font-weight: 600; }

/* 「最常吃的三道」做成成绩单：名次徽章 + 菜名 / 次数 + 进度条。
   之前是一条裸进度条，只有菜名和百分比，看不出「第几名」。 */
.rk { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.rk:last-child { margin-bottom: 0; }
.rk-n {
  width: 44rpx; height: 44rpx; flex: 0 0 auto;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 800;
  background: var(--surf2); color: var(--ink2);
}
/* 1 金 / 2 浅金 / 3 陶土橙；第 4 名以后落到上面的默认样式 */
.rk-n--1 { background: var(--acc); color: #FFFFFF; }
.rk-n--2 { background: var(--acc-l); color: var(--acc-ink); }
.rk-n--3 { background: var(--pri-l); color: var(--pri-ink); }
.rk-main { flex: 1; min-width: 0; }
.rk-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10rpx; }
.rk-nm { font-size: 27rpx; font-weight: 700; }
.rk-cnt { font-size: 23rpx; color: var(--ink2); font-weight: 600; }
.rank-bar { height: 14rpx; border-radius: 999rpx; background: var(--surf2); overflow: hidden; }
.rank-fill { height: 100%; border-radius: 999rpx; background: var(--btn-bg); }

.cat { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.cat:last-child { margin-bottom: 0; }
.cat-dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex: 0 0 auto; }
.cat-nm { font-size: 25rpx; width: 108rpx; flex: 0 0 auto; }
.cat-bar { flex: 1; height: 14rpx; border-radius: 999rpx; background: var(--surf2); overflow: hidden; }
.cat-fill { height: 100%; border-radius: 999rpx; }
.cat-pct { font-size: 23rpx; color: var(--ink2); width: 74rpx; text-align: right; font-weight: 600; }

/* ---------- 当天详情弹层 ---------- */
.dt-list { max-height: 52vh; margin-bottom: 22rpx; }
.dt-i {
  display: flex; align-items: center; gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.dt-i:last-child { border-bottom: none; }
.dt-thumb { width: 108rpx; height: 108rpx; border-radius: 20rpx; flex: 0 0 auto; font-size: 36rpx; }
.dt-main { flex: 1; min-width: 0; }
.dt-nm { font-size: 29rpx; font-weight: 700; }
.dt-sub { font-size: 23rpx; color: var(--ink2); margin-top: 6rpx; }

/* ---------- 日历页：操作提示 ---------- */
.cal-hint {
  font-size: 23rpx;
  color: var(--acc-ink);
  background: var(--acc-l);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin-top: 16rpx;
}

/* ---------- 「安排这一天」弹层 ---------- */
.arr-picked {
  white-space: nowrap;
  margin-bottom: 16rpx;
  flex: 0 0 auto;
}
.ap-i {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: var(--pri-l);
  color: var(--pri-ink);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.ap-nm { font-size: 25rpx; font-weight: 600; }
.ap-x { font-size: 22rpx; opacity: 0.7; }

.arr-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  margin-bottom: 16rpx;
  flex: 0 0 auto;
}
.arr-sb-ico { width: 34rpx; height: 34rpx; flex: 0 0 auto; opacity: 0.5; }
.arr-input { flex: 1; font-size: 27rpx; color: var(--ink); }
.arr-ph { color: var(--ink3); }

.arr-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
  flex: 0 0 auto;
}
.arr-tab {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink2);
  background: var(--surf2);
}
.arr-tab--on { background: var(--pri); color: var(--btn-ink); }

/* 安排列表：行比「当天详情」更紧凑 */
.dt-list .dt-thumb { width: 92rpx; height: 92rpx; font-size: 32rpx; }

.ar-btn {
  width: 64rpx; height: 64rpx; flex: 0 0 auto;
  border-radius: 50%;
  background: var(--btn-bg);
  color: var(--btn-ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 700;
}
.ar-btn--on { background: var(--ok); }
.theme-dark .ar-btn--on { color: #2A5F54; }

.ar-empty {
  text-align: center;
  color: var(--ink3);
  font-size: 25rpx;
  padding: 60rpx 0;
}

.arr-actions { flex: 0 0 auto; margin-top: 22rpx; }

/* ---------- 接下来的安排 ----------
   排版对齐「本月回顾」那些卡片：行内左右各留 28rpx（原来只有 4rpx，字直接贴在卡片边上，
   看着又紧又糙），日期与「N 道」同一行左右对开，菜名另起一行；分隔线内缩，像系统列表。 */
.up-i {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
}
.up-i:last-child { border-bottom: none; }
.up-l { flex: 1; min-width: 0; }
.up-hd { display: flex; align-items: baseline; }
.up-d {
  font-size: 28rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.up-c {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink2);
}
.up-n { font-size: 24rpx; color: var(--ink2); margin-top: 10rpx; line-height: 1.6; }
.up-arw { color: var(--ink3); font-size: 34rpx; line-height: 1; flex: 0 0 auto; }
.up-tip { font-size: 22rpx; color: var(--ink3); margin: 14rpx 0 0 6rpx; }

/* ---------- 菜品详情（叠在安排弹层之上） ---------- */
.sheet-mask--top { z-index: 130; }
.ad-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
}
.ad-hero {
  width: 100%;
  height: 260rpx;
  border-radius: 26rpx;
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.ad-tags { display: flex; gap: 10rpx; flex-wrap: wrap; margin-bottom: 22rpx; }
.ad-sec { margin-bottom: 26rpx; }
.ad-h {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink2);
  letter-spacing: 0.08em;
  margin-bottom: 14rpx;
}
.ad-h-n { font-weight: 600; color: var(--ink3); margin-left: 8rpx; letter-spacing: 0; }
.ad-ing { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ad-ing-i {
  font-size: 24rpx;
  font-weight: 600;
  background: var(--ok-l);
  color: var(--ok-ink);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.ad-tx { font-size: 27rpx; color: var(--ink2); line-height: 1.6; }
.ad-steps {
  background: var(--surf);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 6rpx 24rpx;
}
.ad-step {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.ad-step:last-child { border-bottom: none; }
.ad-step-n {
  flex: 0 0 auto;
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  background: var(--pri-l);
  color: var(--pri-ink);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}
.ad-step-t { flex: 1; font-size: 28rpx; line-height: 1.62; color: var(--ink); }
