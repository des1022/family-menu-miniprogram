.hd { padding: 24rpx 4rpx 8rpx; }

/* ---------- 月份切换 ---------- */
.calh {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 18rpx 0 22rpx;
}
.calh-a {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--ink2);
  border-radius: 50%;
  background: var(--surf);
  border: 2rpx solid var(--line);
}
.calh-m { font-size: 34rpx; font-weight: 700; letter-spacing: -0.01em; }

/* ---------- 月概览 ---------- */
.calstat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--pri-l);
  border: 2rpx solid var(--pri);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 26rpx;
}
.calstat-n { font-size: 44rpx; font-weight: 800; color: var(--pri-ink); line-height: 1; }
.calstat-tx { font-size: 25rpx; color: var(--ink); line-height: 1.5; }
.calstat-hl { font-weight: 700; }

/* ---------- 日期网格 ---------- */
.calgrid { display: flex; flex-wrap: wrap; }
.calgrid .wd {
  width: 14.28%;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
  font-weight: 600;
  padding-bottom: 10rpx;
}
.cell {
  width: 14.28%;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  border-radius: 18rpx;
}
.cell--blank { visibility: hidden; }
.cell--today { background: var(--pri); }
.theme-dark .cell--today { background: #FFFFFF; }
@media (prefers-color-scheme: dark) {
  .cell--today { background: #FFFFFF; }
}
.cell-d { font-size: 27rpx; font-weight: 600; color: var(--ink); line-height: 1.25; }
.cell--today .cell-d { color: var(--btn-ink); font-weight: 800; }
.theme-dark .cell--today .cell-d { color: #2A5F54; }
@media (prefers-color-scheme: dark) {
  .cell--today .cell-d { color: #2A5F54; }
}
.cell-dots {
  display: flex;
  gap: 5rpx;
  margin-top: 7rpx;
  height: 12rpx;
  align-items: center;
}
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.cell--today .dot { outline: 2rpx solid rgba(255, 255, 255, 0.7); }

.cal-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  justify-content: center;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.lg { font-size: 21rpx; color: var(--ink2); display: flex; align-items: center; gap: 8rpx; }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; }
.lg-dot--today { background: var(--pri); }
.theme-dark .lg-dot--today { background: #FFFFFF; }
.lg-t { font-size: 21rpx; color: var(--ink3); }

/* ---------- 本月回顾 ---------- */
.rv-t { font-size: 26rpx; font-weight: 700; margin-bottom: 20rpx; }
.rv-tx { font-size: 26rpx; color: var(--ink2); line-height: 1.7; }
.rv-tip { background: var(--acc-l); border-color: var(--acc); }
.rv-tip .rv-tx { color: var(--acc-ink); font-weight: 600; }

.rank { margin-bottom: 22rpx; }
.rank:last-child { margin-bottom: 0; }
.rank-hd { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10rpx; }
.rank-nm { font-size: 27rpx; font-weight: 600; }
.rank-num { font-size: 23rpx; color: var(--ink2); font-weight: 600; }
.rank-bar { height: 14rpx; border-radius: 999rpx; background: var(--surf2); overflow: hidden; }
.rank-fill { height: 100%; border-radius: 999rpx; background: var(--btn-bg); }

.cat { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.cat:last-child { margin-bottom: 0; }
.cat-dot { width: 18rpx; height: 18rpx; border-radius: 50%; flex: 0 0 auto; }
.cat-nm { font-size: 25rpx; width: 108rpx; flex: 0 0 auto; }
.cat-bar { flex: 1; height: 14rpx; border-radius: 999rpx; background: var(--surf2); overflow: hidden; }
.cat-fill { height: 100%; border-radius: 999rpx; }
.cat-pct { font-size: 23rpx; color: var(--ink2); width: 74rpx; text-align: right; font-weight: 600; }

/* ---------- 当天详情弹层 ---------- */
.dt-list { max-height: 52vh; margin-bottom: 22rpx; }
.dt-i {
  display: flex; align-items: center; gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.dt-i:last-child { border-bottom: none; }
.dt-thumb { width: 108rpx; height: 108rpx; border-radius: 20rpx; flex: 0 0 auto; font-size: 36rpx; }
.dt-main { flex: 1; min-width: 0; }
.dt-nm { font-size: 29rpx; font-weight: 700; }
.dt-sub { font-size: 23rpx; color: var(--ink2); margin-top: 6rpx; }
