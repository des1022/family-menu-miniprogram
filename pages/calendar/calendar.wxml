<view class="page page--tab">
  <!-- 月份切换 -->
  <view class="cal-header">
    <view class="cal-arrow" bindtap="prevMonth">‹</view>
    <view class="cal-month">
      <view class="cal-month-text">{{monthText}}</view>
      <view class="cal-month-sub" wx:if="{{monthTotal > 0}}">本月点了 {{monthTotal}} 份菜</view>
    </view>
    <view class="cal-arrow" bindtap="nextMonth">›</view>
  </view>

  <!-- 星期表头 -->
  <view class="cal-week">
    <view class="cal-week-item" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view>
  </view>

  <!-- 日期网格 -->
  <view class="cal-grid">
    <view class="cal-row" wx:for="{{weeks}}" wx:key="index" wx:for-item="week" wx:for-index="wIdx">
      <view
        class="cal-cell {{cell ? '' : 'cal-cell--blank'}}"
        wx:for="{{week}}"
        wx:key="date"
        wx:for-item="cell"
        data-date="{{cell.date}}"
        bindtap="onDayTap"
      >
        <block wx:if="{{cell}}">
          <view class="cal-day {{cell.date === today ? 'cal-day--today' : ''}}">
            <text class="cal-day-num {{cell.date === today ? 'cal-day-num--today' : ''}}">{{cell.day}}</text>
          </view>
          <view class="cal-mark" wx:if="{{cell.mark && cell.mark.totalNum > 0}}">{{cell.mark.totalNum}}份</view>
        </block>
      </view>
    </view>
  </view>

  <view class="cal-tip">· 点击有标记的日期，查看当天菜单 ·</view>
</view>

<!-- 当日明细弹层 -->
<view class="detail-mask" wx:if="{{detail}}" bindtap="closeDetail" catchtouchmove="noop">
  <view class="detail-sheet" catchtap="noop">
    <view class="detail-hd">
      <view>
        <view class="detail-title">{{detail.dateText}}</view>
        <view class="detail-sub">共 {{detail.list.length}} 道 · {{detail.totalNum}} 份</view>
      </view>
      <view class="detail-close" bindtap="closeDetail">✕</view>
    </view>
    <scroll-view class="detail-list" scroll-y>
      <view class="detail-item" wx:for="{{detail.list}}" wx:key="_id">
        <image class="detail-img" src="{{item.dishImage}}" mode="aspectFill" lazy-load />
        <view class="detail-info">
          <view class="detail-name">{{item.dishName}}</view>
          <view class="detail-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
        </view>
        <text class="detail-num">×{{item.num}}</text>
      </view>
    </scroll-view>
    <view class="detail-ft safe-bottom">
      <view
        class="btn btn-primary btn-block {{reuseLoading ? 'btn--disabled' : ''}}"
        bindtap="onReuse"
      >{{reuseLoading ? '复用中…' : '一键复用到今日点单'}}</view>
    </view>
  </view>
</view>
