<view class="page page--tab {{themeCls}}">
  <view class="page-body">

    <view class="hd">
      <view>
        <view class="t-h1">日历</view>
        <view class="t-sub">这一个月的餐桌</view>
      </view>
    </view>

    <!-- 月历：月份 / 星期 / 日期 / 图例收进同一张卡片（方案 B 格子块） -->
    <view class="cal-card">
      <view class="calh">
        <view class="calh-a" bindtap="prevMonth">‹</view>
        <view class="calh-m">{{monthText}}</view>
        <view class="calh-a" bindtap="nextMonth">›</view>
      </view>

      <!-- 星期表头 -->
      <view class="calgrid">
        <view class="wd" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</view>
      </view>

      <!-- 日期网格：每格一个浅底方块；有记录的换暖色底，今天实心主色 -->
      <view class="calgrid">
        <view
          class="cell {{cell ? '' : 'cell--blank'}}"
          wx:for="{{cells}}"
          wx:for-item="cell"
          wx:key="key"
          data-date="{{cell.date}}"
          bindtap="onDayTap"
        >
          <block wx:if="{{cell}}">
            <view class="tile {{cell.dots.length ? 'tile--rec' : ''}} {{cell.date === today ? 'tile--today' : ''}}">
              <view class="cell-d">{{cell.day}}</view>
              <view class="cell-dots" wx:if="{{cell.dots.length}}">
                <view class="dot" wx:for="{{cell.dots}}" wx:for-item="dot" wx:key="*this" style="background:{{dot}}"></view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="cal-legend">
        <text class="lg"><text class="lg-dot lg-dot--rec"></text>有记录</text>
        <text class="lg"><text class="lg-dot lg-dot--today"></text>今天</text>
      </view>

      <!-- 操作提示收进卡内（原来在卡外，看着和月历是两件事）；图例里那句长解释去掉了 -->
      <view class="cal-tip">点任意日期，就能安排那天吃什么 —— 可以提前排未来几天</view>
    </view>

    <!-- 接下来的安排（提前排好的菜） -->
    <block wx:if="{{upcoming.length}}">
      <view class="sec-h"><text class="sec-t">接下来的安排</text><text class="sec-m">{{upcoming.length}} 天</text></view>
      <view class="card">
        <view class="up-i" wx:for="{{upcoming}}" wx:key="date" data-date="{{item.date}}" bindtap="onUpTap">
          <view class="up-clip">
            <text class="up-day">{{item.day}}</text>
            <text class="up-wk">{{item.wk}}</text>
          </view>
          <text class="up-n">{{item.names}}</text>
          <text class="up-c">{{item.count}} 道</text>
          <text class="up-arw">›</text>
        </view>
      </view>
      <view class="up-tip">点一行就能继续加菜或撤菜</view>
    </block>

    <!-- 本月回顾 -->
    <block wx:if="{{mealCount}}">
      <view class="sec-h"><text class="sec-t">本月回顾</text></view>

      <!-- 月概览：暖色横幅（左边「N 顿在家吃」，右边「最爱」） -->
      <view class="statbar">
        <view class="statbar-l">
          <text class="statbar-n">{{mealCount}}</text>
          <text class="statbar-u">顿在家吃</text>
        </view>
        <view class="statbar-r" wx:if="{{topName}}">
          最爱
          <text class="statbar-fav">{{topName}} · {{topNum}} 次</text>
        </view>
      </view>

      <view class="card card-pad">
        <view class="rv-t">最常吃的三道</view>
        <view class="rk" wx:for="{{top3}}" wx:key="name">
          <view class="rk-n rk-n--{{index + 1}}">{{index + 1}}</view>
          <view class="rk-main">
            <view class="rk-top">
              <text class="rk-nm">{{item.name}}</text>
              <text class="rk-cnt">{{item.count}} 次</text>
            </view>
            <view class="rank-bar"><view class="rank-fill" style="width:{{item.pct}}%"></view></view>
          </view>
        </view>
      </view>

      <view class="card card-pad card-gap" wx:if="{{cats.length}}">
        <view class="rv-t">分类占比</view>
        <view class="cat" wx:for="{{cats}}" wx:key="name">
          <text class="cat-dot" style="background:{{item.color}}"></text>
          <text class="cat-nm">{{item.name}}</text>
          <view class="cat-bar"><view class="cat-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
          <text class="cat-pct">{{item.pct}}%</text>
        </view>
      </view>

      <view class="card card-pad rv-tip card-gap" wx:if="{{tipText}}">
        <view class="rv-t">小建议</view>
        <view class="rv-tx">{{tipText}}</view>
      </view>
    </block>

    <empty
      wx:if="{{!loading && !mealCount}}"
      ico="cal"
      text="这个月还没有记录"
      sub="点上面的日期就能安排那天吃什么，也可以去「今晚」点菜"
    />

  </view>

  <!-- 某天的一桌菜 / 提前安排 -->
  <view class="sheet-mask" wx:if="{{arr}}" bindtap="closeArr" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-grab"></view>

      <view class="sheet-hd">
        <view>
          <view class="sheet-t">{{arr.title}}</view>
          <view class="t-micro">已排 {{arr.picked.length}} 道 · 点菜名看做法，点 ＋ 加进这一天</view>
        </view>
        <view class="sheet-x" bindtap="closeArr">✕</view>
      </view>

      <!-- 已排的菜（点一下撤掉） -->
      <scroll-view class="arr-picked" scroll-x enable-flex show-scrollbar="{{false}}" wx:if="{{arr.picked.length}}">
        <view class="ap-i" wx:for="{{arr.picked}}" wx:key="dishId" data-id="{{item.dishId}}" bindtap="onUnplan">
          <text class="ap-nm">{{item.name}}</text>
          <text class="ap-x">✕</text>
        </view>
      </scroll-view>

      <!-- 搜索 -->
      <view class="arr-search">
        <image class="arr-sb-ico" src="{{ico.search}}"/>
        <input
          class="arr-input"
          value="{{arr.keyword}}"
          placeholder="搜索菜名 / 食材"
          placeholder-class="arr-ph"
          bindinput="onArrSearch"
        />
      </view>

      <!-- 常吃 / 全部 -->
      <view class="arr-tabs">
        <view class="arr-tab {{arr.tab === 'all' ? 'arr-tab--on' : ''}}" data-t="all" bindtap="onArrTab">全部菜</view>
        <view class="arr-tab {{arr.tab === 'fav' ? 'arr-tab--on' : ''}}" data-t="fav" bindtap="onArrTab">★ 常吃</view>
      </view>

      <scroll-view class="dt-list" scroll-y>
        <view class="dt-i" wx:for="{{arr.items}}" wx:key="_id" data-id="{{item._id}}" bindtap="onOpenDish">
          <view class="dt-thumb img-ph {{item.ph}}">{{item.initial}}</view>
          <view class="dt-main">
            <view class="dt-nm">{{item.name}}</view>
            <view class="dt-sub">{{item.sub}}</view>
          </view>
          <view class="ar-btn {{item.on ? 'ar-btn--on' : ''}}" catchtap="onPlan" data-id="{{item._id}}">{{item.on ? '✓' : '＋'}}</view>
        </view>
        <view class="ar-empty" wx:if="{{!arr.items.length}}">
          {{arr.keyword ? '没找到这道菜' : '这个筛选下没有菜'}}
        </view>
      </scroll-view>

      <view class="btn-row arr-actions">
        <view class="btn btn-ghost" wx:if="{{arr.canReuse}}" bindtap="onReuse">加进今晚</view>
        <view class="btn btn-primary" bindtap="closeArr">完成</view>
      </view>
    </view>
  </view>

  <!-- 菜品详情（在安排弹层之上，和菜库里点菜名看到的一样） -->
  <view class="sheet-mask sheet-mask--top" wx:if="{{arrDetail}}" bindtap="closeDish" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-grab"></view>

      <view class="sheet-hd">
        <view>
          <view class="sheet-t">{{arrDetail.name}}</view>
          <view class="t-micro">{{arrDetail.meta}}</view>
        </view>
        <view class="sheet-x" bindtap="closeDish">✕</view>
      </view>

      <scroll-view class="ad-scroll" scroll-y>
        <image class="ad-hero dish-dim" wx:if="{{arrDetail.imgSrc}}" src="{{arrDetail.imgSrc}}" mode="aspectFill"/>
        <view class="ad-hero img-ph {{arrDetail.ph}}" wx:else>{{arrDetail.initial}}</view>
        <view class="ad-tags">
          <text class="tag" wx:if="{{arrDetail.category}}">{{arrDetail.category}}</text>
          <text class="tag tag--pri" wx:for="{{arrDetail.tagList}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="ad-sec" wx:if="{{arrDetail.ingList.length}}">
          <view class="ad-h">食材</view>
          <view class="ad-ing">
            <text class="ad-ing-i" wx:for="{{arrDetail.ingList}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <view class="ad-sec" wx:if="{{arrDetail.desc}}">
          <view class="ad-h">备注</view>
          <view class="ad-tx">{{arrDetail.desc}}</view>
        </view>
        <view class="ad-sec" wx:if="{{arrDetail.stepList.length}}">
          <view class="ad-h">做法 <text class="ad-h-n">{{arrDetail.stepList.length}} 步</text></view>
          <view class="ad-steps">
            <view class="ad-step" wx:for="{{arrDetail.stepList}}" wx:key="index">
              <text class="ad-step-n">{{index + 1}}</text>
              <text class="ad-step-t">{{item}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="btn btn-block {{arrDetail.on ? 'btn-plain' : 'btn-primary'}}" bindtap="onDetailToggle">
        {{arrDetail.on ? '从这一天撤掉' : '加进这一天'}}
      </view>
    </view>
  </view>

  <!-- 统一确认弹窗：utils/util.js 的 confirm()/alert() 会自动找到它 -->
  <ui-dialog id="uiDialog"/>
</view>
