.page {
  padding: 24rpx 24rpx 200rpx;
}

/* 汇总卡 */
.summary-card {
  display: flex;
  align-items: center;
  background: #FFF0E8;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.summary-left { flex: 1; }

.summary-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2E24;
}

.summary-sub {
  font-size: 26rpx;
  color: #8A9099;
  margin-top: 6rpx;
}

.summary-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF7A45;
}

/* 记录卡片 */
.order-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.order-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.order-main {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.order-name-line {
  display: flex;
  align-items: center;
}

.order-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-num {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FF7A45;
  flex-shrink: 0;
}

.order-remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5A6068;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-remark--empty {
  color: #B4B9C0;
}

.order-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-price {
  font-size: 24rpx;
  color: #FF7A45;
}

.order-confirmed {
  font-size: 22rpx;
  color: #52A256;
  background: #E9F6EA;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

/* 操作列 */
.order-ops {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #FFC9AE;
  color: #FF7A45;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn--plus {
  background: #FF7A45;
  color: #fff;
  border-color: #FF7A45;
}

.step-num {
  min-width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FF7A45;
}

.order-remove {
  font-size: 24rpx;
  color: #C0392B;
  text-decoration: underline;
  padding: 4rpx 8rpx;
}

/* 底部按钮 */
.confirm-ft {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(31, 35, 41, 0.06);
}

.btn-row {
  display: flex;
  gap: 20rpx;
}
