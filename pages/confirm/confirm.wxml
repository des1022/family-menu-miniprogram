<view class="page">
  <view class="summary-card" wx:if="{{!empty}}">
    <view class="summary-left">
      <view class="summary-title">今日点单</view>
      <view class="summary-sub">共 {{totalDish}} 道 · {{totalNum}} 份</view>
    </view>
    <view class="summary-price" wx:if="{{totalPriceText !== '0'}}">¥{{totalPriceText}}</view>
  </view>

  <view class="quick-row" wx:if="{{!empty}}">
    <view class="quick-btn" bindtap="onTapIngredients">🥬 生成食材清单</view>
    <view class="quick-btn" bindtap="goPoster">🎨 生成海报</view>
  </view>

  <view class="order-list" wx:if="{{!empty}}">
    <view class="order-card" wx:for="{{list}}" wx:key="_id">
      <image class="order-img" src="{{item.dishImage}}" mode="aspectFill" lazy-load />
      <view class="order-main">
        <view class="order-name-line">
          <text class="order-name">{{item.dishName}}</text>
          <text class="order-num">×{{item.num}}</text>
        </view>
        <view
          class="order-remark {{item.remark ? '' : 'order-remark--empty'}}"
          data-id="{{item._id}}"
          bindtap="onEditRemark"
        >{{item.remark ? '备注：' + item.remark : '＋ 加备注（少辣/忌口…）'}}</view>
        <view class="order-meta">
          <text class="order-price" wx:if="{{item.price > 0}}">¥{{item.priceText}}/份</text>
          <text class="order-confirmed" wx:if="{{item.confirmed}}">已确认 ✓</text>
        </view>
      </view>
      <view class="order-ops">
        <view class="stepper">
          <view class="step-btn" data-id="{{item._id}}" bindtap="onDec">－</view>
          <text class="step-num">{{item.num}}</text>
          <view class="step-btn step-btn--plus" data-id="{{item._id}}" bindtap="onInc">＋</view>
        </view>
        <view class="order-remove" data-id="{{item._id}}" bindtap="onRemove">删除</view>
      </view>
    </view>
  </view>

  <empty
    wx:if="{{empty}}"
    text="今天还没点单"
    sub="回首页挑几道喜欢的菜吧"
  />

  <!-- 食材清单弹层 -->
  <view class="detail-mask" wx:if="{{showIngredients}}" bindtap="closeIngredients" catchtouchmove="noop">
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-hd">
        <view>
          <view class="detail-title">🥬 今日食材清单</view>
          <view class="detail-sub">数字为该食材涉及的点单份数</view>
        </view>
        <view class="detail-close" bindtap="closeIngredients">✕</view>
      </view>
      <scroll-view class="ing-list" scroll-y>
        <view class="ing-item" wx:for="{{ingredientList}}" wx:key="name">
          <text class="ing-name">{{item.name}}</text>
          <text class="ing-times">×{{item.times}} 份</text>
        </view>
      </scroll-view>
      <view class="detail-ft safe-bottom">
        <view class="btn btn-primary btn-block" bindtap="onCopyIngredients">复制清单</view>
      </view>
    </view>
  </view>

  <view class="confirm-ft safe-bottom" wx:if="{{!empty}}">
    <view class="btn-row">
      <view class="btn btn-ghost btn-block" bindtap="onClearAll">清空未确认</view>
      <view class="btn btn-primary btn-block" bindtap="onConfirmOrder">确认点单</view>
    </view>
  </view>
</view>
