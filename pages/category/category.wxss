.page {
  padding: 20rpx 0 60rpx;
}

.add-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}

.add-input {
  flex: 1;
  height: 88rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.add-btn {
  width: 140rpx;
  height: 88rpx;
  margin-left: 20rpx;
  border-radius: 12rpx;
  background: var(--pri);
  color: var(--surf);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn:active {
  background: var(--pri-d);
}

.ph {
  color: var(--ink3);
}

.section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: 28rpx;
  color: var(--ink2);
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F5F6F7;
  min-height: 104rpx;
}

.cat-item:last-child {
  border-bottom: none;
}

.cat-info {
  display: flex;
  align-items: baseline;
}

.cat-name {
  font-size: 32rpx;
  color: var(--ink);
}

.cat-count {
  font-size: 24rpx;
  color: var(--ink3);
  margin-left: 16rpx;
}

.cat-del {
  padding: 12rpx 28rpx;
  border-radius: 10rpx;
  background: var(--surf);
  color: var(--danger);
  font-size: 28rpx;
}

.tip {
  margin: 32rpx 32rpx 0;
  font-size: 24rpx;
  color: var(--ink3);
  line-height: 1.7;
}
