<view class="page page--tab">
  <view class="seg">
    <view class="seg-chip {{period === 0 ? 'seg-chip--on' : ''}}" data-p="0" bindtap="onSwitchPeriod">本周</view>
    <view class="seg-chip {{period === 1 ? 'seg-chip--on' : ''}}" data-p="1" bindtap="onSwitchPeriod">本月</view>
  </view>

  <skeleton wx:if="{{!loaded}}" count="3" />

  <block wx:if="{{loaded && stats}}">
    <view class="range">{{stats.rangeText}}</view>

    <empty wx:if="{{!stats.rank.length}}" text="这段时间还没有点单记录" sub="去首页点几道菜，这里就会有统计啦" />

    <block wx:if="{{stats.rank.length}}">
      <!-- 概览 -->
      <view class="tiles">
        <view class="tile"><view class="tile-num">{{stats.dayCount}}</view><view class="tile-label">点单天</view></view>
        <view class="tile"><view class="tile-num">{{stats.dishCount}}</view><view class="tile-label">吃过菜</view></view>
        <view class="tile"><view class="tile-num">{{stats.totalNum}}</view><view class="tile-label">总份数</view></view>
      </view>

      <!-- 最爱排行 -->
      <view class="card">
        <view class="card-title">🍽 最爱排行</view>
        <view class="rank" wx:for="{{stats.rank}}" wx:key="name">
          <view class="rank-line">
            <text class="rank-name">{{item.name}}</text>
            <text class="rank-num">{{item.num}}份</text>
          </view>
          <view class="rank-bar" style="width: {{item.pct}}%;"></view>
        </view>
      </view>

      <!-- 分类占比 -->
      <view class="card">
        <view class="card-title">🥘 分类占比</view>
        <view class="cat" wx:for="{{stats.cats}}" wx:key="name">
          <view class="cat-dot" style="background: {{item.color}};"></view>
          <text class="cat-name">{{item.name}}</text>
          <view class="cat-bar-wrap">
            <view class="cat-bar" style="width: {{item.pct}}%; background: {{item.color}};"></view>
          </view>
          <text class="cat-pct">{{item.pct}}%</text>
        </view>
      </view>

      <!-- 小建议 -->
      <view class="card card--tip">
        <view class="card-title">💡 小建议</view>
        <view class="tip-text">
          这段时间最爱吃的是「{{stats.topName}}」（{{stats.topNum}} 份）。{{tipText}}
        </view>
      </view>
    </block>
  </block>
</view>
