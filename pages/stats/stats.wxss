.page {
  padding: 24rpx 24rpx 60rpx;
}

.seg {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.seg-chip {
  padding: 12rpx 40rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5A6068;
  font-size: 28rpx;
  border: 2rpx solid #EDEEF0;
}

.seg-chip--on {
  background: #FF7A45;
  color: #fff;
  border-color: #FF7A45;
  font-weight: 600;
}

.range {
  font-size: 24rpx;
  color: #8A9099;
  margin-bottom: 14rpx;
}

.tiles {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tile {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 0;
  text-align: center;
}

.tile-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF7A45;
}

.tile-label {
  font-size: 24rpx;
  color: #8A9099;
  margin-top: 4rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.card--tip {
  background: #FFF0E8;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A2E24;
  margin-bottom: 14rpx;
}

.rank {
  margin-bottom: 14rpx;
}

.rank-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rank-name {
  font-size: 28rpx;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-num {
  font-size: 24rpx;
  color: #8A9099;
  flex-shrink: 0;
}

.rank-bar {
  height: 10rpx;
  background: #FF7A45;
  border-radius: 5rpx;
  margin-top: 8rpx;
}

.cat {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.cat-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.cat-name {
  width: 110rpx;
  font-size: 26rpx;
  color: #1F2329;
  flex-shrink: 0;
}

.cat-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #F2F3F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.cat-bar {
  height: 100%;
  border-radius: 6rpx;
}

.cat-pct {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #8A9099;
  flex-shrink: 0;
}

.tip-text {
  font-size: 28rpx;
  color: #3A2E24;
  line-height: 1.6;
}
