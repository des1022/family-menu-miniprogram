.page {
  padding: 24rpx 24rpx 60rpx;
}

.tpl-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tpl-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: var(--surf);
  color: var(--ink2);
  font-size: 26rpx;
  border: 2rpx solid var(--line);
}

.tpl-chip--on {
  background: var(--pri);
  color: var(--surf);
  border-color: var(--pri);
  font-weight: 600;
}

.canvas-wrap {
  position: relative;
  width: 100%;
}

.poster-canvas {
  width: 100%;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.08);
}

.gen-mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gen-text {
  font-size: 28rpx;
  color: var(--ink2);
}

.tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
}

.btn--disabled {
  opacity: 0.6;
}

/* ---------- 文案表单 ----------
   原来这一块是「一个 .form-row 只装标签 + 下面一个裸 input」，
   结果页面上是两个空荡荡的圆角条 + 两个独立输入框，看着像没画完。
   现在按「一行小标题 + 一个输入框」的字段块来排（数值对齐家庭页的表单）。 */
.fld-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.fld-l { font-size: 24rpx; font-weight: 700; color: var(--ink2); }
.fld-x {
  font-size: 23rpx; font-weight: 700; color: var(--pri-ink);
  background: var(--pri-l); border-radius: 999rpx; padding: 6rpx 20rpx;
}
/* 深色下 --pri-l 是半透明白、--pri-ink 是纯白 → 白字压浅白会糊，换暖色（和全站一套） */
.theme-dark .fld-x { background: var(--acc-l); color: var(--acc-ink); }
@media (prefers-color-scheme: dark) {
  .fld-x { background: var(--acc-l); color: var(--acc-ink); }
}
.fld-in {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  background: var(--surf2);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  font-size: 29rpx;
  color: var(--ink);
}
.fld-h { font-size: 22rpx; color: var(--ink3); margin-top: 12rpx; line-height: 1.6; }
.ph { color: var(--ink3); font-size: 29rpx; }
