.page {
  padding: 24rpx 24rpx 60rpx;
}

.tpl-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tpl-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: var(--surf);
  color: var(--ink2);
  font-size: 26rpx;
  border: 2rpx solid var(--line);
}

.tpl-chip--on {
  background: var(--pri);
  color: var(--surf);
  border-color: var(--pri);
  font-weight: 600;
}

.canvas-wrap {
  position: relative;
  width: 100%;
}

.poster-canvas {
  width: 100%;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.08);
}

.gen-mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gen-text {
  font-size: 28rpx;
  color: var(--ink2);
}

.tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink3);
}

.btn--disabled {
  opacity: 0.6;
}

/* ---------- 表单行（本页原先缺少这些类的定义，补上） ---------- */
.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  background: var(--surf);
  border-radius: 22rpx;
  border: 2rpx solid var(--line);
  box-shadow: var(--sh);
}
.form-label {
  width: 130rpx;
  flex: 0 0 auto;
  font-size: 26rpx;
  color: var(--ink2);
}
.form-input {
  flex: 1;
  font-size: 29rpx;
  color: var(--ink);
}
.ph { color: var(--ink3); font-size: 29rpx; }
