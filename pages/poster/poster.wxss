.page {
  padding: 24rpx 24rpx 60rpx;
}

.tpl-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.tpl-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: #fff;
  color: #5A6068;
  font-size: 26rpx;
  border: 2rpx solid #EDEEF0;
}

.tpl-chip--on {
  background: #FF7A45;
  color: #fff;
  border-color: #FF7A45;
  font-weight: 600;
}

.canvas-wrap {
  position: relative;
  width: 100%;
}

.poster-canvas {
  width: 100%;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.08);
}

.gen-mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gen-text {
  font-size: 28rpx;
  color: #8A9099;
}

.tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B4B9C0;
}

.btn--disabled {
  opacity: 0.6;
}
