<view class="page {{themeCls}}">
  <!-- 文案（标题每次进页面随机给一句温馨话，也可以自己改 / 点「换一句」） -->
  <view class="card card-pad">
    <view class="fld">
      <view class="fld-hd">
        <text class="fld-l">海报标题</text>
        <text class="fld-x" bindtap="onShuffleTitle">换一句 ↻</text>
      </view>
      <input
        class="fld-in"
        value="{{title}}"
        maxlength="12"
        bindinput="onTitleInput"
        placeholder="比如：灶上有火，桌边有人"
        placeholder-class="ph"
      />
      <view class="fld-h">每次进这一页都会换一句；分享时用哪句，以海报上显示为准。</view>
    </view>

    <view class="fld" style="margin-top: 24rpx;">
      <view class="fld-hd"><text class="fld-l">底部文案</text></view>
      <input
        class="fld-in"
        value="{{footer}}"
        maxlength="16"
        bindinput="onFooterInput"
        placeholder="今晚吃这些，幸福！"
        placeholder-class="ph"
      />
    </view>
  </view>

  <!-- 模板 -->
  <view class="tpl-bar">
    <view
      class="tpl-chip {{variant === item.key ? 'tpl-chip--on' : ''}}"
      wx:for="{{variants}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchVariant"
    >{{item.label}}</view>
  </view>

  <!-- 画布预览 -->
  <view class="canvas-wrap">
    <canvas
      type="2d"
      id="posterCanvas"
      class="poster-canvas"
      style="height: {{dispH}}px;"
    ></canvas>
    <view class="gen-mask" wx:if="{{generating}}">
      <text class="gen-text">生成中…</text>
    </view>
  </view>

  <empty wx:if="{{empty}}" text="这一天还没有点单" sub="先去首页点几道菜再来生成海报吧" />

  <view class="btn-row" wx:if="{{!empty}}">
    <view class="btn btn-primary btn-block {{saving ? 'btn--disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存到相册'}}
    </view>
  </view>
  <view class="tip" wx:if="{{!empty}}">保存后可在微信里长按图片发送给家人，或直接转发本小程序</view>

  <!-- 统一确认弹窗：utils/util.js 的 confirm()/alert() 会自动找到它 -->
  <ui-dialog id="uiDialog"/>
</view>
