.page {
  padding: 20rpx 0 60rpx;
}

.card-title {
  padding: 28rpx 32rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.required {
  color: var(--danger);
}

/* ===== 图片 ===== */
.img-wrap {
  position: relative;
  margin: 0 32rpx 32rpx;
  height: 340rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg);
}

.dish-img {
  width: 100%;
  height: 340rpx;
}

.img-placeholder {
  height: 340rpx;
  border: 2rpx dashed #DCDFE5;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.img-plus {
  font-size: 72rpx;
  color: #C9CDD4;
  line-height: 1;
}

.img-tip {
  font-size: 26rpx;
  color: var(--ink3);
  margin-top: 16rpx;
}

.img-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: var(--surf);
  font-size: 26rpx;
}

/* ===== 表单 ===== */
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  min-height: 100rpx;
  border-bottom: 2rpx solid #F5F6F7;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row--top {
  align-items: flex-start;
}

.form-label {
  width: 200rpx;
  font-size: 30rpx;
  color: var(--ink);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
  text-align: right;
}

.form-textarea {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
  min-height: 120rpx;
  line-height: 1.6;
}

.ph {
  color: var(--ink3);
}

.picker-view {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 30rpx;
  color: var(--ink);
  min-height: 60rpx;
}

.arrow {
  font-size: 40rpx;
  color: #C9CDD4;
  margin-left: 8rpx;
  line-height: 1;
}

/* ===== 按钮 ===== */
.btn-row {
  display: flex;
  margin: 40rpx 24rpx 0;
}

.btn-row .btn {
  flex: 1;
  margin: 0 12rpx;
}


/* ===== 食材/标签 ===== */
.form-tip {
  font-size: 22rpx;
  color: var(--ink3);
}

.tag-group {
  margin-top: 16rpx;
}

.tag-group-name {
  font-size: 24rpx;
  color: var(--ink2);
  margin-bottom: 10rpx;
}

.tag-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #F5F6F7;
  color: var(--ink2);
  font-size: 26rpx;
  border: 2rpx solid #F5F6F7;
}

.tag-chip--on {
  background: #FFF0E8;
  color: var(--pri);
  border-color: #FFC9AE;
  font-weight: 600;
}

/* ---------- 做法步骤 ---------- */
.form-textarea--steps {
  min-height: 260rpx;
  line-height: 1.8;
}
.form-h {
  font-size: 23rpx;
  color: var(--ink3);
  margin-top: 12rpx;
}

/* ---------- 搜菜名，一键填好 ---------- */
.recipe-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surf2);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
}
.recipe-input { flex: 1; font-size: 29rpx; color: var(--ink); }
.recipe-x {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--line);
  color: var(--ink2);
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}
.recipe-tip { font-size: 23rpx; color: var(--ink3); margin-top: 14rpx; }
.recipe-list { margin-top: 18rpx; }
.recipe-i {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
  background: var(--surf2);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
}
.recipe-i:last-child { margin-bottom: 0; }
.recipe-i--hover { opacity: 0.72; }
.ri-main { flex: 1; min-width: 0; }
.ri-nm { font-size: 29rpx; font-weight: 700; }
.ri-mt {
  font-size: 22rpx;
  color: var(--ink2);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ri-go {
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--pri-ink);
  background: var(--pri-l);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.recipe-none {
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 1.7;
  padding: 6rpx 4rpx;
}
/* 图片改成选填后，标题下给一句说明 */
.img-hint { font-size: 23rpx; color: var(--ink3); margin: -6rpx 0 16rpx; }
