<view class="page">
  <!-- 搜菜名一键填好：内置菜谱库，不用联网、不用一个个字段敲 -->
  <view class="card recipe">
    <view class="card-title">搜菜名，一键填好</view>
    <view class="recipe-bar">
      <input
        class="recipe-input"
        value="{{kw}}"
        placeholder="试试「宫保鸡丁」「西红柿」"
        placeholder-class="ph"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchInput"
      />
      <view class="recipe-x" wx:if="{{kw}}" bindtap="onClearSearch">✕</view>
    </view>

    <view class="recipe-tip" wx:if="{{!kw}}">
      内置 60 道家常菜，会自动填好分类、食材和做法步骤
    </view>

    <view class="recipe-list" wx:if="{{kw}}">
      <view
        class="recipe-i"
        wx:for="{{hits}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onPickRecipe"
        hover-class="recipe-i--hover"
      >
        <view class="ri-main">
          <view class="ri-nm">{{item.name}}</view>
          <view class="ri-mt">{{item.category}} · {{item.brief}}</view>
        </view>
        <view class="ri-go">填入</view>
      </view>
      <view class="recipe-none" wx:if="{{!hits.length}}">
        菜谱库里没有「{{kw}}」。换个说法试试（「西红柿」也能搜到番茄），或者照旧手动填下面的字段。
      </view>
    </view>
  </view>

  <!-- 菜品图片（选填） -->
  <view class="card">
    <view class="card-title">菜品图片</view>
    <view class="img-hint">不传也行，会用菜名首字的色块显示</view>
    <view class="img-wrap" bindtap="onChooseImage">
      <image wx:if="{{form.image}}" class="dish-img" src="{{form.image}}" mode="aspectFill" />
      <view wx:else class="img-placeholder">
        <view class="img-plus">＋</view>
        <view class="img-tip">点击从相册选择</view>
      </view>
      <view class="img-mask" wx:if="{{form.image}}">点击更换</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">菜品名称 <text class="required">*</text></text>
      <input
        class="form-input"
        value="{{form.name}}"
        maxlength="10"
        placeholder="最多 10 个字"
        placeholder-class="ph"
        bindinput="onInput"
        data-field="name"
      />
    </view>

    <view class="form-row">
      <text class="form-label">菜品分类 <text class="required">*</text></text>
      <picker
        range="{{pickerRange}}"
        value="{{pickerIndex}}"
        bindchange="onCategoryPick"
      >
        <view class="picker-view">
          <text class="{{form.category ? '' : 'ph'}}">{{form.category || '请选择分类'}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 手动输入新增分类 -->
    <view class="form-row" wx:if="{{showNewCat}}">
      <text class="form-label">新分类名</text>
      <input
        class="form-input"
        value="{{newCategory}}"
        maxlength="8"
        placeholder="输入新分类名称"
        placeholder-class="ph"
        bindinput="onInput"
        data-field="newCategory"
      />
    </view>

    <view class="form-row">
      <text class="form-label">价格</text>
      <input
        class="form-input"
        value="{{form.price}}"
        type="digit"
        maxlength="8"
        placeholder="选填，留空表示时价"
        placeholder-class="ph"
        bindinput="onInput"
        data-field="price"
      />
    </view>

    <view class="form-row form-row--top">
      <text class="form-label">描述</text>
      <textarea
        class="form-textarea"
        value="{{form.desc}}"
        maxlength="30"
        placeholder="选填，最多 30 字"
        placeholder-class="ph"
        auto-height
        bindinput="onInput"
        data-field="desc"
      />
    </view>
  </view>

  <!-- 食材清单 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">食材清单</text>
      <text class="form-tip">选填，点单页可汇总成买菜清单</text>
    </view>
    <textarea
      class="form-textarea"
      value="{{form.ingredients}}"
      maxlength="80"
      placeholder="如：西红柿,鸡蛋,葱（逗号/顿号分隔）"
      placeholder-class="ph"
      auto-height
      bindinput="onInput"
      data-field="ingredients"
    />
  </view>

  <!-- 做法步骤 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">做法步骤</text>
      <text class="form-tip">选填，每行一步</text>
    </view>
    <textarea
      class="form-textarea form-textarea--steps"
      value="{{form.steps}}"
      maxlength="600"
      placeholder="一行写一步，例如：&#10;1 番茄去皮切块，鸡蛋打散&#10;2 热锅多油炒蛋，凝固就盛出&#10;3 炒番茄出汁，倒回鸡蛋翻匀"
      placeholder-class="ph"
      auto-height
      bindinput="onInput"
      data-field="steps"
    />
    <view class="form-h">做饭的人点开菜品就能照着做</view>
  </view>

  <!-- 标签 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">标签</text>
      <text class="form-tip">选填，首页可按标签筛选</text>
    </view>
    <view class="tag-group" wx:for="{{tagGroups}}" wx:key="name" wx:for-item="group">
      <view class="tag-group-name">{{group.name}}</view>
      <view class="tag-chips">
        <view
          class="tag-chip {{selectedMap[option] ? 'tag-chip--on' : ''}}"
          wx:for="{{group.options}}"
          wx:key="*this"
          wx:for-item="option"
          data-tag="{{option}}"
          bindtap="onToggleTag"
        >{{option}}</view>
      </view>
    </view>
  </view>

  <!-- 上架状态：新增默认上架 -->
  <view class="card" wx:if="{{isEdit}}">
    <view class="form-row">
      <text class="form-label">上架状态</text>
      <switch
        color="#FF7A45"
        checked="{{form.status === 1}}"
        bindchange="onStatusChange"
      />
    </view>
  </view>

  <view class="btn-row">
    <view class="btn btn-ghost btn-block" bindtap="onCancel">取消</view>
    <view class="btn btn-primary btn-block" bindtap="onSave">保存</view>
  </view>
</view>
