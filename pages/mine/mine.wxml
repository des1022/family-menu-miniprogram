<view class="page page--tab">
  <!-- 昵称 -->
  <view class="card">
    <view class="form-row">
      <text class="form-label">我的昵称</text>
      <input
        class="form-input"
        value="{{nickname}}"
        maxlength="10"
        placeholder="例如：爸爸 / 小明"
        placeholder-class="ph"
        bindblur="onNicknameBlur"
      />
    </view>
    <view class="form-hint">点单备注时会用到，方便家人认领口味</view>
  </view>

  <!-- 管理入口 -->
  <view class="card">
    <view class="cell" bindtap="goAdd">
      <text class="cell-title">🍚 上传菜品</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goAdmin">
      <text class="cell-title">📖 菜品管理</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goCategory">
      <text class="cell-title">🗂 分类管理</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goStats">
      <text class="cell-title">📊 饮食统计</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 使用说明 -->
  <view class="card">
    <view class="card-title">使用说明</view>
    <view class="help-item">
      <text class="help-num">1</text>
      <text class="help-text">「上传菜品」录入拿手菜：照片、食材、标签，一次录入长期用。</text>
    </view>
    <view class="help-item">
      <text class="help-num">2</text>
      <text class="help-text">首页点菜 → 底部「今日点单」清单 → 确认点单，菜单自动进日历。</text>
    </view>
    <view class="help-item">
      <text class="help-num">3</text>
      <text class="help-text">「日历」点有标记的日子，可看当天菜单并一键复用到今天。</text>
    </view>
    <view class="help-item">
      <text class="help-num">4</text>
      <text class="help-text">全家数据实时同步：谁点了菜、谁录了菜，大家都能马上看到。</text>
    </view>
  </view>

  <!-- 数据 -->
  <view class="card">
    <view class="cell" bindtap="onClearCache">
      <text class="cell-title">清空本地缓存</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>
</view>
