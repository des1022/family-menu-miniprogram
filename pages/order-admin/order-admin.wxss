.page {
  padding-bottom: 80rpx;
}

.seg-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0F1F3;
}

.seg-inner {
  display: inline-flex;
  padding: 0 24rpx;
}

.seg-item {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #4E5969;
  background: #F2F3F5;
  white-space: nowrap;
}

.seg-item--active {
  background: #FFF3ED;
  color: #FF7A45;
  font-weight: 600;
}

.order-card {
  padding: 24rpx 32rpx;
}

.order-card--done {
  opacity: 0.6;
}

.order-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F5F6F7;
}

.order-nick {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}

.order-goods {
  padding: 16rpx 0;
}

.og-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.og-name {
  font-size: 30rpx;
  color: #1F2329;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.og-num {
  font-size: 30rpx;
  color: #4E5969;
  margin-left: 20rpx;
}

.order-remark {
  background: #F7F8FA;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: #4E5969;
  margin-bottom: 16rpx;
}

.order-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14rpx;
  border-top: 2rpx solid #F5F6F7;
}

.order-time {
  font-size: 26rpx;
  color: #8A9099;
  flex: 1;
}

.order-total {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF7A45;
}

.op-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F5F6F7;
}

.op-btn {
  padding: 12rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 26rpx;
}

.op-btn--active {
  background: #FFF3ED;
  color: #FF7A45;
  font-weight: 600;
}

.op-btn--danger {
  background: #FFF1F0;
  color: #F5222D;
  margin-right: 0;
  margin-left: auto;
}
