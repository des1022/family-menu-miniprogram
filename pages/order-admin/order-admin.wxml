<view class="page">
  <view class="seg-bar">
    <scroll-view scroll-x show-scrollbar="{{false}}">
      <view class="seg-inner">
        <view class="seg-item {{filter === -1 ? 'seg-item--active' : ''}}" data-s="-1" bindtap="onFilter">全部</view>
        <view class="seg-item {{filter === 0 ? 'seg-item--active' : ''}}" data-s="0" bindtap="onFilter">待制作</view>
        <view class="seg-item {{filter === 1 ? 'seg-item--active' : ''}}" data-s="1" bindtap="onFilter">制作中</view>
        <view class="seg-item {{filter === 2 ? 'seg-item--active' : ''}}" data-s="2" bindtap="onFilter">已完成</view>
      </view>
    </scroll-view>
  </view>

  <skeleton wx:if="{{loading && !showList.length}}" count="3" />

  <view
    class="card order-card {{item.status === 2 ? 'order-card--done' : ''}}"
    wx:for="{{showList}}"
    wx:key="_id"
  >
    <view class="order-hd">
      <text class="order-nick">{{item.nickname}}</text>
      <text class="tag {{item.status === 2 ? 'tag-gray' : (item.status === 1 ? 'tag-green' : '')}}">{{item.statusText}}</text>
    </view>

    <view class="order-goods">
      <view class="og-row" wx:for="{{item.goods}}" wx:for-item="g" wx:key="id">
        <text class="og-name">{{g.name}}</text>
        <text class="og-num">×{{g.num}}</text>
      </view>
    </view>

    <view class="order-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>

    <view class="order-ft">
      <text class="order-time">{{item.timeText}} · 共 {{item.totalNum}} 份</text>
      <text class="order-total" wx:if="{{item.totalPrice > 0}}">¥{{item.totalPriceText}}</text>
    </view>

    <view class="op-row">
      <view
        class="op-btn {{item.status === 0 ? 'op-btn--active' : ''}}"
        data-id="{{item._id}}" data-status="0" bindtap="onChangeStatus"
      >标记待制作</view>
      <view
        class="op-btn {{item.status === 1 ? 'op-btn--active' : ''}}"
        data-id="{{item._id}}" data-status="1" bindtap="onChangeStatus"
      >标记制作中</view>
      <view
        class="op-btn {{item.status === 2 ? 'op-btn--active' : ''}}"
        data-id="{{item._id}}" data-status="2" bindtap="onChangeStatus"
      >标记已完成</view>
      <view class="op-btn op-btn--danger" data-id="{{item._id}}" bindtap="onDelete">删除</view>
    </view>
  </view>

  <empty wx:if="{{!loading && !showList.length}}" text="没有符合条件的订单" />
</view>
