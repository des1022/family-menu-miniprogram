.cart-root {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
}

/* ===== 遮罩 ===== */
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 0.2s;
}

.cart-mask.show {
  opacity: 1;
}

/* ===== 明细弹窗 ===== */
.cart-detail {
  position: relative;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 62vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 902;
}

.cart-detail.show {
  transform: translateY(0);
}

.detail-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #EBEDF0;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2329;
}

.detail-clear {
  font-size: 28rpx;
  color: #8A9099;
  padding: 8rpx 4rpx;
}

.detail-bd {
  flex: 1;
  max-height: 720rpx;
  padding: 0 32rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F5F6F7;
}

.goods-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}

.goods-name {
  font-size: 30rpx;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price {
  font-size: 28rpx;
  color: #FF7A45;
  margin-top: 6rpx;
}

.stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
}

.step-btn:active {
  opacity: 0.7;
}

.step-btn.plus {
  background: #FF7A45;
  color: #fff;
}

.step-btn.minus {
  background: #F2F3F5;
  color: #4E5969;
  border: 2rpx solid #E5E6EB;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1F2329;
}

.detail-ft {
  padding: 20rpx 32rpx 20rpx;
  border-top: 2rpx solid #EBEDF0;
  background: #fff;
}

/* ===== 悬浮条 ===== */
.cart-bar {
  position: relative;
  z-index: 903;
  margin: 0 24rpx calc(112rpx + env(safe-area-inset-bottom)) 24rpx;
  height: 104rpx;
  background: #2B2F36;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.bar-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FF7A45;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-cart {
  width: 36rpx;
  height: 32rpx;
  border: 4rpx solid #fff;
  border-radius: 6rpx;
  position: relative;
}

.icon-cart::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 6rpx;
  width: 20rpx;
  height: 10rpx;
  border: 4rpx solid #fff;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: #F5222D;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #2B2F36;
}

.bar-text {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.bar-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.bar-tip {
  font-size: 24rpx;
  color: #A9AEB8;
}
