<view class="cart-root" wx:if="{{totalNum > 0}}">
  <view class="cart-bar" bindtap="goList" hover-class="cart-bar--hover">
    <view class="bar-icon">
      <view class="icon-cart"></view>
      <view class="badge">{{totalNum}}</view>
    </view>
    <view class="bar-text">
      <text class="bar-price">今日点单 · {{dishCount}} 道</text>
      <text class="bar-tip">共 {{totalNum}} 份 · 点击查看清单</text>
    </view>
  </view>
</view>
