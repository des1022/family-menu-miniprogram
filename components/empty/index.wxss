.empty {
  padding: 120rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F2F3F5;
  position: relative;
  margin-bottom: 32rpx;
}

.empty-icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 48rpx;
  height: 8rpx;
  background: #DCDFE5;
  border-radius: 4rpx;
  transform: translate(-50%, -50%);
}

.empty-text {
  font-size: 30rpx;
  color: #8A9099;
}

.empty-sub {
  font-size: 26rpx;
  color: #B4B9C0;
  margin-top: 12rpx;
  text-align: center;
}
