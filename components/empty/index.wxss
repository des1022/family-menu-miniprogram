.empty {
  padding: 96rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 圆底 + 图标。颜色全部走主题变量，深色自动跟随。 */
.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--pri-l);
  border: 2rpx solid rgba(217, 113, 78, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-img {
  width: 64rpx;
  height: 64rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--ink2);
  margin-top: 12rpx;
  line-height: 1.65;
  text-align: center;
}

/* 深色下 --pri-l 是半透明白，那圈橙色描边会显脏，换成淡白 */
.theme-dark .empty-icon { border-color: rgba(255, 255, 255, 0.2); }
@media (prefers-color-scheme: dark) {
  .empty-icon { border-color: rgba(255, 255, 255, 0.2); }
}
