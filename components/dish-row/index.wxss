.dish-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.dish-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}

.dish-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 26rpx;
  color: #8A9099;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-foot {
  margin-top: auto;
  padding-top: 10rpx;
}

.dish-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF7A45;
}

.dish-price--none {
  font-size: 26rpx;
  font-weight: 400;
  color: #B4B9C0;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FF7A45;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 69, 0.35);
}

.add-btn--hover {
  background: #E85F2B;
  transform: scale(0.92);
}

.add-plus {
  color: #fff;
  font-size: 44rpx;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== family-menu 扩展 ===== */
.dish-name-line {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.dish-fav {
  margin-left: 8rpx;
  font-size: 26rpx;
}

.dish-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 6rpx;
  overflow: hidden;
}

.dish-tag {
  font-size: 20rpx;
  color: #FF7A45;
  background: #FFF0E8;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.add-wrap {
  flex-shrink: 0;
  min-width: 150rpx;
  display: flex;
  justify-content: flex-end;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #FFC9AE;
  color: #FF7A45;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF;
}

.step-btn--plus {
  background: #FF7A45;
  color: #fff;
  border-color: #FF7A45;
}

.step-btn--hover {
  transform: scale(0.92);
  opacity: 0.85;
}

.step-num {
  min-width: 44rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FF7A45;
}
